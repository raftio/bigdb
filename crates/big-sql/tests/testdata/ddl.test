# `CREATE TABLE`, and what each type name means.
#
# The mapping from a SQL type name onto a field kind is this crate's dialect: there is no field
# kind spelled `TEXT` anywhere below it. `TEXT` is a `Set` because a keyed field is what a
# string lands in, and `BIGINT` is 64 bits because that is what `BIGINT` has always been.
#
# A column list is not a transaction. A table and its fields are separate changes below this
# crate, and there is no journal that would let a half-applied batch be undone. What the list
# buys is one round of validation before anything is created - every kind, depth and scale here
# is decided while the statement is parsed, so the failure it can still leave behind is a node
# that went quiet mid-way, never a `DECIMAL` somebody forgot to give a scale.

ddl
CREATE TABLE events
----
CreateTable events

ddl
CREATE TABLE events ()
----
CreateTable events

ddl
CREATE TABLE IF NOT EXISTS events (a SET)
----
CreateTable events if_not_exists
└── a set depth=32

ddl
CREATE TABLE events ENGINE = columnar
----
CreateTable events engine=columnar

ddl
CREATE TABLE events ENGINE = 'bitmap+columnar'
----
CreateTable events engine=bitmap+columnar

# The native spellings, which are the ones `SHOW CREATE` writes back.
ddl
CREATE TABLE t (a SET, b MUTEX, c BOOL, d TIMEQUANTUM, e SIGNED, f UINT(12))
----
CreateTable t
├── a set depth=32
├── b mutex depth=32
├── c bool depth=32
├── d timequantum depth=32
├── e signed depth=32
└── f int depth=12

ddl
CREATE TABLE t (a SIGNED, b SIGNED(12))
----
CreateTable t
├── a signed depth=32
└── b signed depth=12

ddl
CREATE TABLE t (a UINT(1), b UINT(12), c UINT(64))
----
CreateTable t
├── a int depth=1
├── b int depth=12
└── c int depth=64

# The SQL spellings, and what each of them lands on. A width that this engine cannot honour -
# `VARCHAR(255)`, `INT(11)` - is refused rather than reinterpreted; see refusals.test for why a
# display width is not a bit depth.
ddl
CREATE TABLE t (a TEXT, b VARCHAR, c CHAR, d STRING)
----
CreateTable t
├── a set depth=32
├── b set depth=32
├── c set depth=32
└── d set depth=32

ddl
CREATE TABLE t (a TINYINT, b SMALLINT, c INT, d INTEGER, e BIGINT)
----
CreateTable t
├── a int depth=8
├── b int depth=16
├── c int depth=32
├── d int depth=32
└── e int depth=64

ddl
CREATE TABLE t (a INT UNSIGNED, b BIGINT SIGNED, c SMALLINT SIGNED)
----
CreateTable t
├── a int depth=32
├── b signed depth=64
└── c signed depth=16

ddl
CREATE TABLE t (a BOOLEAN, b TIMESTAMP, c DATETIME)
----
CreateTable t
├── a bool depth=32
├── b datetime depth=64
└── c datetime depth=64

# `DATE` and `DATETIME` are scalar kinds of their own, and `TIMEQUANTUM` keeps its own spelling.
# They used to be the same thing, and the split is what makes `WHERE d >= '2024-01-01'`,
# `ORDER BY d` and `max(d)` askable: a time quantum is keyed, so it answers `f = 'k'` and a
# window and nothing else. A date counts days from the epoch and a datetime counts seconds,
# which is why their depths differ.
ddl
CREATE TABLE t (a DATE, b TIMESTAMP, c TIMEQUANTUM)
----
CreateTable t
├── a date depth=32
├── b datetime depth=64
└── c timequantum depth=32

# The widths are in the names, so `FLOAT` and `REAL` are the narrow one and `DOUBLE` the wide.
# `DOUBLE PRECISION` is read rather than refused, for the reason `INT UNSIGNED` is: it is a word
# that says what was already meant.
ddl
CREATE TABLE t (a FLOAT, b REAL, c FLOAT32, d DOUBLE, e FLOAT64, f DOUBLE PRECISION)
----
CreateTable t
├── a float32 depth=32
├── b float32 depth=32
├── c float32 depth=32
├── d float64 depth=64
├── e float64 depth=64
└── f float64 depth=64

ddl
CREATE TABLE t (a TEXT, b BIGINT, c BOOLEAN, d TIMESTAMP)
----
CreateTable t
├── a set depth=32
├── b int depth=64
├── c bool depth=32
└── d datetime depth=64

# A decimal keeps its scale, which is what every value written to it is converted against.
ddl
CREATE TABLE t (a DECIMAL(10, 2), b NUMERIC(4, 4), c DECIMAL(19, 0))
----
CreateTable t
├── a decimal depth=34 scale=2
├── b decimal depth=14 scale=4
└── c decimal depth=64 scale=0

# A comment inside a column list is a comment, and a trailing one is still a column list.
ddl
CREATE TABLE t (a SET, -- the key
 b INT)
----
CreateTable t
├── a set depth=32
└── b int depth=32

ddl
DROP TABLE events
----
DropTable events

ddl
DROP TABLE IF EXISTS events
----
DropTable events if_exists

ddl
ALTER TABLE events ADD COLUMN region TEXT
----
AlterTable events
└── add region set depth=32

ddl
ALTER TABLE t ADD a SET
----
AlterTable t
└── add a set depth=32

ddl
ALTER TABLE t ADD COLUMN a SET, ADD COLUMN b BIGINT
----
AlterTable t
├── add a set depth=32
└── add b int depth=64

ddl
ALTER TABLE t DROP COLUMN a
----
AlterTable t
└── drop a

ddl
ALTER TABLE t DROP a
----
AlterTable t
└── drop a

ddl
ALTER TABLE t ADD COLUMN a DECIMAL(10, 2), DROP COLUMN b
----
AlterTable t
├── add a decimal depth=34 scale=2
└── drop b

# `SHOW CREATE` is the inverse of the table above, written from the same mapping so the two
# cannot drift apart. The native spelling comes back whichever spelling went in: `TEXT` and
# `SET` create the same field, and answering with the name of the thing that exists is more use
# than answering with the name somebody happened to type.
render
CREATE TABLE t (a SET, b MUTEX, c BOOL, d TIMEQUANTUM, e SIGNED, f UINT(12))
----
CREATE TABLE t (
    a SET,
    b MUTEX,
    c BOOL,
    d TIMEQUANTUM,
    e SIGNED(32),
    f UINT(12)
)

render
CREATE TABLE t (a TEXT, b VARCHAR, c BIGINT, d BOOLEAN, e TIMESTAMP)
----
CREATE TABLE t (
    a SET,
    b SET,
    c UINT(64),
    d BOOL,
    e DATETIME
)

# `LowCardinality` names an encoding rather than a domain, and the encoding is the one a set
# already has: one interned key, one bitmap. So it renders back as `SET` like every other
# spelling of a keyed string, and the inner type name is read for what it says rather than kept.
render
CREATE TABLE t (a LowCardinality(String), b LowCardinality(VARCHAR), c SET)
----
CREATE TABLE t (
    a SET,
    b SET,
    c SET
)

# Every SQL spelling of a float and a date renders back as the native one, and reads back as the
# same column. `REAL` and `DOUBLE PRECISION` have no width in brackets on the way out because
# their names already carry it.
render
CREATE TABLE t (a FLOAT, b REAL, c DOUBLE, d DOUBLE PRECISION, e DATE, f TIMESTAMP)
----
CREATE TABLE t (
    a FLOAT32,
    b FLOAT32,
    c FLOAT64,
    d FLOAT64,
    e DATE,
    f DATETIME
)

render
CREATE TABLE t (a DECIMAL(10, 2), b NUMERIC(4, 4))
----
CREATE TABLE t (
    a DECIMAL(10, 2),
    b DECIMAL(4, 4)
)

render
CREATE TABLE t (a INT UNSIGNED, b BIGINT SIGNED)
----
CREATE TABLE t (
    a UINT(32),
    b SIGNED(64)
)

render
CREATE TABLE t ()
----
CREATE TABLE t

render
CREATE TABLE t (a SET) ENGINE = columnar
----
CREATE TABLE t (
    a SET
) ENGINE = columnar

## `TRUNCATE TABLE`: the records go, the table stays.
#
# It left `Refused::Write` and became a statement because there is an operation behind it - the
# fragments are freed by key, which is `DROP TABLE`'s second half without its first. What it keeps
# is the declaration, the field ids, and the row keys: those are interned per `(table, field)` and
# the write path rests on them never being reused, so a peer's cached mapping must stay true.

ddl
TRUNCATE TABLE events
----
TruncateTable events

# `TABLE` is optional, because Postgres requires it and MySQL does not, and the word decides
# nothing here - there is one kind of object this empties.
ddl
TRUNCATE events
----
TruncateTable events

ddl
TRUNCATE TABLE IF EXISTS events
----
TruncateTable events if_exists

ddl
TRUNCATE TABLE sales.orders
----
TruncateTable sales.orders

## Renaming a table, and swapping two of them.
#
# Both cost catalog records and no data: everything below the catalog is keyed by an interned
# table id, and the id is exactly what does not move. That is why these are statements while
# `RENAME COLUMN` is still refused - a field's name is what routes a fact to a bitmap.

ddl
ALTER TABLE events RENAME TO archive
----
RenameTable events to archive

# `AS` beside `TO`, the way MySQL writes it: a word that says what was already meant.
ddl
ALTER TABLE events RENAME AS archive
----
RenameTable events to archive

# The new name is bare and lands in the database the table is already in. A qualified one is a
# syntax error rather than a refusal - a rename that moved a table is a shape this grammar does
# not have, not a construct with something to write instead.
ddl
ALTER TABLE sales.orders RENAME TO orders_v2
----
RenameTable sales.orders to orders_v2

ddl
EXCHANGE TABLES events AND archive
----
ExchangeTables events and archive

ddl
EXCHANGE TABLES sales.orders AND sales.orders_v2
----
ExchangeTables sales.orders and sales.orders_v2

# One database. Written twice and agreeing is fine; written twice and disagreeing is not a
# statement this grammar has - so it is `parse_error` and not a refusal, because there is no
# other way to write what it asked for.
error
EXCHANGE TABLES sales.orders AND ops.orders
----
parse_error

## Retention: `DROP DAYS BEFORE`, which is an `ALTER` because it changes what the table's index
## holds without changing what the table stores.
#
# Imperative rather than a `TTL` clause, and that is a decision: nothing here would keep a
# standing promise. It also drops the *index* over those periods rather than the records, which
# is why it is not called TTL.

ddl
ALTER TABLE visits DROP DAYS BEFORE '2026-01-01' ON visit
----
AlterTable visits
└── drop days before 2026-01-01 on visit

# Beside other changes, validated with them against the same simulated post-statement schema.
ddl
ALTER TABLE visits ADD COLUMN region TEXT, DROP DAYS BEFORE '2026-01-01' ON visit
----
AlterTable visits
├── add region set depth=32
└── drop days before 2026-01-01 on visit

# The sketch types, refused separately from `BITMAP`: a bitmap is declined because every column
# here already is one, a sketch because there is nothing here for one to approximate.
error
CREATE TABLE t (u HLL)
----
sql_sketch

error
CREATE TABLE t (q QUANTILE_STATE)
----
sql_sketch

# `IPv4` is a 32-bit number, so it is read as one - the same way `TIMESTAMP` is read as
# `DATETIME` and `BIGINT` as `UINT(64)`. Nothing is lost: it compares, sorts and zone-maps as
# what it is, and it writes back under the canonical spelling.
ddl
CREATE TABLE t (client IPv4)
----
CreateTable t
└── client int depth=32

# `UUID` and `IPv6` are not, and the difference is what would be lost. Both are 128 bits where a
# bit-sliced value stops at 64, so the only column they could land in is keyed - which answers
# `=` but not `<`. Refused rather than accepted with the ordering quietly gone.
error
CREATE TABLE t (id UUID)
----
sql_unknown_column_type

error
CREATE TABLE t (client IPv6)
----
sql_unknown_column_type

## `ENUM`: a `MUTEX` that also declares which values it may hold.
#
# The kind stored is a mutex — one value per record over an interned dictionary, which is exactly
# what an enum wants — and the member list travels beside it as metadata. That is what makes this
# free below the catalog: no new `FieldKind`, no engine change, no storage format for a value.
#
# What the list buys is the two things a mutex cannot say: a write outside it is refused, and the
# declared type survives `SHOW CREATE TABLE` instead of coming back as `MUTEX`.

ddl
CREATE TABLE t (status ENUM('new', 'paid', 'shipped'))
----
CreateTable t
└── status mutex depth=32 members=['new', 'paid', 'shipped']

# `Enum8` and `Enum16` are the same declaration. The width names how many members fit, and the
# dictionary underneath has no such ceiling — so it is read and dropped, the way `INT UNSIGNED`'s
# word is.
ddl
CREATE TABLE t (status Enum8('a', 'b'))
----
CreateTable t
└── status mutex depth=32 members=['a', 'b']

ddl
CREATE TABLE t (status Enum16('a'))
----
CreateTable t
└── status mutex depth=32 members=['a']

# **The numbers are refused, not ignored.** `Enum8('a' = 1)` says which integer the value is
# stored as, and here the dictionary assigns that — so an accepted `= 1` would be a promise about
# storage that nothing keeps.
error
CREATE TABLE t (status Enum8('a' = 1, 'b' = 2))
----
sql_enum_type

# A duplicate member would be unreachable, and would make `SHOW CREATE TABLE` disagree with what
# was typed.
error
CREATE TABLE t (status ENUM('a', 'a'))
----
sql_enum_type

# An enum of nothing is a column that can hold nothing.
error
CREATE TABLE t (status ENUM())
----
parse_error
