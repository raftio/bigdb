# The shape that is about records rather than about counts of them.
#
# A projection reads values back, and that is the whole of what it costs: a record's value in a
# bit-sliced field is not stored anywhere as a number, so reconstructing it means one bit per
# plane per record per column. The `LIMIT` is what bounds that, which is why it is part of the
# plan rather than a view of its answer - a cut applied to the answer would be one applied after
# paying for it. Without a `LIMIT` the statement asks for every match, at that price.
#
# `SELECT *` is a projection of every column the table declares. The list is not in the
# statement, because the statement is written before anything knows the table, so both halves of
# the answer are filled in against the schema out of one expansion - a plan reading three
# columns under a header of four would be an answer that is wrong rather than absent.

plan
SELECT * FROM t
----
Project t.(amount, price, balance, category, country, device, visit, active, rate, day, seen)
└── all

shape
SELECT * FROM t
----
Table
├── amount
├── price scale=2
├── balance
├── category
├── country
├── device
├── visit
├── active
├── rate
├── day units=date
└── seen units=datetime

plan
SELECT * FROM t WHERE active = true
----
Project t.(amount, price, balance, category, country, device, visit, active, rate, day, seen)
└── active = true

plan
SELECT * FROM t WHERE country = 'GB' AND amount > 5
----
Project t.(amount, price, balance, category, country, device, visit, active, rate, day, seen)
└── intersect
    ├── country = 'GB'
    └── amount > 5

plan
SELECT * FROM t LIMIT 10
----
Project t.(amount, price, balance, category, country, device, visit, active, rate, day, seen) limit=10
└── all

shape
SELECT * FROM t LIMIT 10
----
Table
├── amount
├── price scale=2
├── balance
├── category
├── country
├── device
├── visit
├── active
├── rate
├── day units=date
└── seen units=datetime

# `*` expands to the columns a projection could actually read, which is not always every column
# the table has. `u` keeps no values, so its keyed and boolean columns have no read back from a
# record at all and the star does not name them - where naming one by hand is refused. The three
# bit-sliced columns are still there: those reconstruct from their planes either way.
plan
SELECT * FROM u
----
Project u.(amount, price, balance, rate, day, seen)
└── all

shape
SELECT * FROM u
----
Table
├── amount
├── price scale=2
├── balance
├── rate
├── day units=date
└── seen units=datetime

# Where nothing at all could be read - a table with no fields - the star falls back to record
# ids, which is the answer it gave before it expanded to anything. The plan and the header fall
# back together, out of the same expansion. See `records.test` in `big-cluster` for the case
# with data behind it.

plan
SELECT amount FROM t LIMIT 10
----
Project t.(amount) limit=10
└── all

shape
SELECT amount FROM t LIMIT 10
----
Table
└── amount

plan
SELECT amount, price FROM t LIMIT 10
----
Project t.(amount, price) limit=10
└── all

shape
SELECT amount, price FROM t LIMIT 10
----
Table
├── amount
└── price scale=2

# The order the columns are written is the order the cells come in.
plan
SELECT price, amount FROM t LIMIT 10
----
Project t.(price, amount) limit=10
└── all

shape
SELECT price, amount FROM t LIMIT 10
----
Table
├── price scale=2
└── amount

plan
SELECT amount AS a, price FROM t LIMIT 5
----
Project t.(amount, price) limit=5
└── all

shape
SELECT amount AS a, price FROM t LIMIT 5
----
Table
├── a
└── price scale=2

plan
SELECT amount, price FROM t WHERE country = 'GB' LIMIT 10
----
Project t.(amount, price) limit=10
└── country = 'GB'

plan
SELECT balance FROM t LIMIT 10
----
Project t.(balance) limit=10
└── all

# `u` keeps no values, so there is nothing to read back from a record there.
plan
SELECT amount FROM u LIMIT 10
----
Project u.(amount) limit=10
└── all

# A keyed column has no read back from a record to its string unless the values are stored.
plan
SELECT country FROM t LIMIT 10
----
Project t.(country) limit=10
└── all

plan
SELECT country FROM u LIMIT 10
----
did not resolve: `a projection` is not allowed on `country`, which is a keyed field

# A projection with no limit is a full scan: every record the `WHERE` selects, at a point read
# per record per column. The plan says so by carrying no cut at all.
plan
SELECT amount FROM t
----
Project t.(amount)
└── all

shape
SELECT amount FROM t
----
Table
└── amount

plan
SELECT amount, price FROM t WHERE country = 'GB'
----
Project t.(amount, price)
└── country = 'GB'

# A limit past what used to be the cap is a smaller ask than the statement above it, so there is
# nothing left for a cap to protect.
plan
SELECT amount FROM t LIMIT 100000
----
Project t.(amount) limit=100000
└── all

# `LIMIT 0` reads nothing rather than being refused: it is the cut it says it is.
plan
SELECT amount FROM t LIMIT 0
----
Project t.(amount) limit=0
└── all

## `toDate` and `date_trunc`: a rounding applied where the answer is written.
##
## The plan is unchanged - it reads the column it was always going to read - and the whole of
## what the function does shows up in the shape, as the `apply` on the column. That is the point
## of them: they cost a projection nothing, because they are arithmetic on a number that had
## already been read.

plan
SELECT toDate(seen) FROM t
----
Project t.(seen)
└── all

shape
SELECT toDate(seen) FROM t
----
Table
└── toDate units=date apply=toDate

# The units change with `toDate` and not with `date_trunc`: the day an instant falls in is a
# date, and a truncated timestamp is still a timestamp, at midnight or on the hour.
shape
SELECT date_trunc('month', seen) FROM t
----
Table
└── date_trunc('month') units=datetime apply=date_trunc('month')

# Over a column of whole days the rounding stays in days.
shape
SELECT date_trunc('quarter', day) FROM t
----
Table
└── date_trunc('quarter') units=date apply=date_trunc('quarter')

# `toDate` of a date has nothing to do, and says so as the identity truncation it is - which is
# what keeps every combination of (units, apply) readable one way at the far end.
shape
SELECT toDate(day) FROM t
----
Table
└── toDate units=date apply=date_trunc('day')

# An alias names the column and the rounding still shows, which is the case the printer exists
# for: without `apply` this would be indistinguishable from a bare `SELECT seen AS seen`.
shape
SELECT date_trunc('year', seen) AS seen, amount FROM t
----
Table
├── seen units=datetime apply=date_trunc('year')
└── amount
