# Grouping, and everything applied to the groups after the merge.
#
# `HAVING`, `ORDER BY` and the cut are not in the plan on purpose - see `crate::shape`. A group
# under the threshold on one node can be over it once every node has contributed, so the plan
# carries the grouping and the coordinator carries the rest. Where the plan *can* do the work,
# it does: a plain descending ranking with a limit is a `TopN`, which ranks and truncates in one
# pass, and that is visible here as the difference between two nearly identical statements.

plan
SELECT category, count(*) FROM t GROUP BY category
----
GroupBy t.category -> count
└── all

plan
SELECT category FROM t GROUP BY category
----
Distinct t.category
└── all

plan
SELECT category, sum(amount) FROM t GROUP BY category
----
GroupBy t.category -> sum(amount)
└── all

plan
SELECT category, min(amount) FROM t GROUP BY category
----
GroupBy t.category -> min(amount)
└── all

plan
SELECT category, max(amount) FROM t GROUP BY category
----
GroupBy t.category -> max(amount)
└── all

plan
SELECT category, count(*), sum(amount) FROM t GROUP BY category
----
GroupBy t.category -> count
└── all
GroupBy t.category -> sum(amount)
└── all

plan
SELECT category, avg(amount) FROM t GROUP BY category
----
GroupBy t.category -> sum(amount)
└── all
GroupBy t.category -> count
└── all

plan
SELECT category, count(*) FROM t WHERE active = true GROUP BY category
----
GroupBy t.category -> count
└── active = true

plan
SELECT country, count(*) FROM t GROUP BY country
----
GroupBy t.country -> count
└── all

# `SELECT DISTINCT c` is `GROUP BY c` with the counts not rendered.
plan
SELECT DISTINCT category FROM t
----
Distinct t.category
└── all

plan
SELECT DISTINCT category FROM t WHERE amount >= 500
----
Distinct t.category
└── amount >= 500

# Two keyed columns. Not a composite key: for each value of the left the records holding it are
# a set, and grouping those by the right is the ordinary grouping. So the cost is the number of
# values on the left, which is why the plan carries that bound rather than having one applied to
# its answer.
plan
SELECT category, country, count(*) FROM t GROUP BY category, country
----
GroupByPair t.(category, country) left_max=1000 -> count
└── all

plan
SELECT DISTINCT category, country FROM t
----
GroupByPair t.(category, country) left_max=1000 -> count
└── all

plan
SELECT category, country, sum(amount) FROM t GROUP BY category, country
----
GroupByPair t.(category, country) left_max=1000 -> sum(amount)
└── all

# A plain descending ranking with a limit is the one case the plan carries the cut itself.
plan
SELECT category, count(*) AS n FROM t GROUP BY category ORDER BY n DESC LIMIT 8
----
TopN t.category n=8
└── all

plan
SELECT category, count(*) FROM t GROUP BY category ORDER BY count(*) DESC LIMIT 3
----
TopN t.category n=3
└── all

# An offset means the rows wanted begin further down than the limit describes, so the ranking
# cannot be truncated to it.
plan
SELECT category, count(*) FROM t GROUP BY category ORDER BY count(*) DESC LIMIT 3 OFFSET 2
----
TopN t.category n=5
└── all

plan
SELECT category, count(*) FROM t GROUP BY category ORDER BY count(*) ASC LIMIT 3
----
GroupBy t.category -> count
└── all

plan
SELECT category, count(*) FROM t GROUP BY category ORDER BY category
----
GroupBy t.category -> count
└── all

plan
SELECT category, count(*) FROM t GROUP BY category ORDER BY category DESC
----
GroupBy t.category -> count
└── all

plan
SELECT category, count(*) FROM t GROUP BY category LIMIT 5
----
GroupBy t.category -> count
└── all

plan
SELECT category, count(*) FROM t GROUP BY category LIMIT 5 OFFSET 5
----
GroupBy t.category -> count
└── all

# A `HAVING` cannot be answered before the merge either, so a `TopN` under one keeps its limit
# in the shape: the plan cannot cut to `n` before the rows that fail the predicate are gone.
plan
SELECT category, count(*) FROM t GROUP BY category HAVING count(*) > 5
----
GroupBy t.category -> count
└── all

plan
SELECT category, count(*) AS n FROM t GROUP BY category HAVING count(*) > 5 ORDER BY n DESC LIMIT 3
----
TopN t.category n=unbounded
└── all

plan
SELECT category, sum(amount) FROM t GROUP BY category HAVING sum(amount) >= 500
----
GroupBy t.category -> sum(amount)
└── all

plan
SELECT category, sum(price) FROM t GROUP BY category HAVING sum(price) >= 10.00
----
GroupBy t.category -> sum(price)
└── all

plan
SELECT category, count(*) FROM t GROUP BY category ORDER BY count(*) DESC LIMIT 3 WITH TIES
----
GroupBy t.category -> count
└── all

# The shapes these produce, which is where every clause above actually lives.
shape
SELECT category, count(*) FROM t GROUP BY category
----
Groups keys=[#0]
├── category = key
└── count = group #0 else 0

shape
SELECT category FROM t GROUP BY category
----
Groups keys=[#0]
└── category = key

shape
SELECT DISTINCT category FROM t
----
Groups keys=[#0]
└── category = key

shape
SELECT category, count(*), sum(amount) FROM t GROUP BY category
----
Groups keys=[#0, #1]
├── category = key
├── count = group #0 else 0
└── sum = group #1 else 0

shape
SELECT category, avg(amount) FROM t GROUP BY category
----
Groups keys=[#0, #1]
├── category = key
└── avg = #0 / #1

shape
SELECT category, sum(price) FROM t GROUP BY category
----
Groups keys=[#0]
├── category = key
└── sum = group #0 else 0 scale=2

shape
SELECT category, country, count(*) FROM t GROUP BY category, country
----
Pairs keys=[#0]
├── category = key
├── country = right key
└── count = group #0 else 0

shape
SELECT category, count(*) AS n FROM t GROUP BY category ORDER BY n DESC LIMIT 8
----
Groups keys=[#0]
├── category = key
└── n = group #0 else 0

shape
SELECT category, count(*) FROM t GROUP BY category ORDER BY count(*) DESC LIMIT 3 OFFSET 2
----
Groups keys=[#0]
├── category = key
├── count = group #0 else 0
└── cut: limit 3 offset 2

shape
SELECT category, count(*) FROM t GROUP BY category ORDER BY category DESC
----
Groups keys=[#0]
├── category = key
├── count = group #0 else 0
└── order: key desc

shape
SELECT category, count(*) FROM t GROUP BY category HAVING count(*) > 5
----
Groups keys=[#0]
├── category = key
├── count = group #0 else 0
└── having: group #0 else 0 > 5

shape
SELECT category, sum(price) FROM t GROUP BY category HAVING sum(price) >= 10.00
----
Groups keys=[#0]
├── category = key
├── sum = group #0 else 0 scale=2
└── having: group #0 else 0 >= 1000

shape
SELECT category, count(*) FROM t GROUP BY category ORDER BY count(*) DESC LIMIT 3 WITH TIES
----
Groups keys=[#0]
├── category = key
├── count = group #0 else 0
├── order: group #0 else 0 desc
└── cut: limit 3 with ties

# A `FILTER` is the one clause that leaves a statement's plans describing different groups: a
# group every record of which the filter rejects is missing from that plan's answer entirely,
# while the others still know it exists. What the cell holds for it is part of the shape.
shape
SELECT category, count(*) FILTER (WHERE amount >= 500) FROM t GROUP BY category
----
Groups keys=[#0, #1]
├── category = key
└── count = group #0 else 0

shape
SELECT category, min(amount) FILTER (WHERE active = true) FROM t GROUP BY category
----
Groups keys=[#0, #1]
├── category = key
└── min = group #0 else null

# A `HAVING` is a tree, not one comparison. `AND`, `OR`, `NOT` and brackets read as they do in a
# `WHERE`, and for the same reason: two grammars that look alike are one grammar to learn. What
# differs is the leaf - a `WHERE` term names a column and a `HAVING` term names an aggregate.
shape
SELECT category, count(*), sum(amount) FROM t GROUP BY category HAVING count(*) > 5 AND sum(amount) < 100
----
Groups keys=[#0, #1]
├── category = key
├── count = group #0 else 0
├── sum = group #1 else 0
└── having: group #0 else 0 > 5 and group #1 else 0 < 100

shape
SELECT category, count(*) FROM t GROUP BY category HAVING count(*) > 5 OR count(*) = 0
----
Groups keys=[#0]
├── category = key
├── count = group #0 else 0
└── having: (group #0 else 0 > 5 or group #0 else 0 = 0)

shape
SELECT category, count(*) FROM t GROUP BY category HAVING NOT (count(*) > 5)
----
Groups keys=[#0]
├── category = key
├── count = group #0 else 0
└── having: not (group #0 else 0 > 5)

# Both sides are numbers the answer already holds, so neither has to be the constant. This is the
# comparison a single-sided clause could not write at all.
#
# Both totals are in whole units here, which is what makes them comparable. Two totals in
# *different* units are refused where the scales are known - see `tests/translate/clauses.rs`,
# which is where a schema exists to know them.
shape
SELECT category, sum(amount), sum(balance) FROM t GROUP BY category HAVING sum(amount) > sum(balance)
----
Groups keys=[#0, #1]
├── category = key
├── sum = group #0 else 0
├── sum = group #1 else 0
└── having: group #0 else 0 > group #1 else 0

# Brackets group, and the printer says which way they went - `or` is bracketed and `and` is not,
# so a tree reads back as the tree it is.
shape
SELECT category, count(*), sum(amount) FROM t GROUP BY category HAVING count(*) > 5 AND (sum(amount) < 100 OR sum(amount) > 900)
----
Groups keys=[#0, #1]
├── category = key
├── count = group #0 else 0
├── sum = group #1 else 0
└── having: group #0 else 0 > 5 and (group #1 else 0 < 100 or group #1 else 0 > 900)

# ---------------------------------------------------------------------------------------------
# Grouping by a calendar bucket
# ---------------------------------------------------------------------------------------------

# The query this file existed without: one row per month, counted. `seen` is a DATETIME and has
# no dictionary to walk, so the plan is not a `GroupBy` at all - it is a walk of the calendar,
# one range read per bucket.

plan
SELECT date_trunc('month', seen), count(*) FROM t GROUP BY date_trunc('month', seen)
----
GroupByBucket t.seen by month n=10000 -> count
└── all

shape
SELECT date_trunc('month', seen), count(*) FROM t GROUP BY date_trunc('month', seen)
----
Groups keys=[#0]
├── date_trunc('month', seen) = key
└── count = group #0 else 0

plan
SELECT date_trunc('year', day), sum(amount) FROM t GROUP BY date_trunc('year', day)
----
GroupByBucket t.day by year n=10000 -> sum(amount)
└── all

# `SELECT DISTINCT` over a rounding is the same grouping written the other way, exactly as it is
# over a bare column.
plan
SELECT DISTINCT date_trunc('month', seen) FROM t
----
GroupByBucket t.seen by month n=10000 -> count
└── all

# An ordering over a bucket grouping is a coordinator sort, never a `TopN`: a ranking is over the
# rows of a keyed field and a bucket grouping has none.
shape
SELECT date_trunc('month', seen), count(*) FROM t GROUP BY date_trunc('month', seen) ORDER BY count(*) DESC LIMIT 3
----
Groups keys=[#0]
├── date_trunc('month', seen) = key
├── count = group #0 else 0
├── order: group #0 else 0 desc
└── cut: limit 3
