error
CREATE TABLE t (a DOUBLE)
----
sql_unknown_column_type

error
CREATE TABLE t (a JSON)
----
sql_unknown_column_type

error
CREATE TABLE t (a BLOB)
----
sql_unknown_column_type

error
CREATE TABLE t (a UUID)
----
sql_unknown_column_type

error
CREATE TABLE t (a DATE)
----
sql_unknown_column_type

## A decimal's scale and a field's depth, both decided while the statement is parsed.

error
CREATE TABLE t (a DECIMAL)
----
sql_decimal_scale

error
CREATE TABLE t (a NUMERIC)
----
sql_decimal_scale

error
CREATE TABLE t (a DECIMAL(10))
----
sql_decimal_scale

error
CREATE TABLE t (a DECIMAL(2, 5))
----
sql_decimal_scale

error
CREATE TABLE t (a DECIMAL(25, 2))
----
sql_bit_depth

error
CREATE TABLE t (a UINT(0))
----
sql_bit_depth

error
CREATE TABLE t (a UINT(65))
----
sql_bit_depth

error
CREATE TABLE t (a SIGNED(65))
----
sql_bit_depth

## Expressions, which have nowhere to run: a record is a set of bits, and there is no row for
## `amount * 2` to be evaluated against.

error
SELECT amount * 2 FROM t
----
sql_unsupported

error
SELECT cast(amount AS BIGINT) FROM t
----
sql_unsupported

error
SELECT toString(amount) FROM t
----
sql_unsupported

error
SELECT toDate(visit) FROM t
----
sql_unsupported

error
SELECT CASE WHEN amount > 5 THEN 1 ELSE 0 END FROM t
----
sql_unsupported

error
SELECT multiIf(amount > 5, 1, 0) FROM t
----
sql_unsupported

error
SELECT coalesce(amount, 0) FROM t
----
sql_unsupported

error
SELECT count(*) FROM t WHERE country LIKE 'G%'
----
sql_unsupported

## Aggregates that need values this index does not keep.

error
SELECT stddevPop(amount) FROM t
----
sql_unsupported

error
SELECT corr(amount, price) FROM t
----
sql_unsupported

error
SELECT argMax(amount, price) FROM t
----
sql_unsupported

error
SELECT any(amount) FROM t
----
sql_unsupported

error
SELECT groupArray(amount) FROM t
----
sql_unsupported


## Rows, in every spelling.

error
SELECT row_number() OVER () FROM t
----
sql_unsupported

error
SELECT count(*) OVER (PARTITION BY category) FROM t
----
sql_unsupported

error
SELECT DISTINCT ON (category) category FROM t
----
sql_unsupported

## A subquery, and a `WITH` whose body is a select.

error
SELECT count(*) FROM t WHERE amount IN (SELECT amount FROM u)
----
sql_unsupported

error
WITH x AS (SELECT 1) SELECT count(*) FROM t
----
sql_unsupported

error
SELECT count(*) FROM (SELECT * FROM t)
----
parse_error

## `HAVING` without a grouping, and the offset a grouped answer cannot take.

error
SELECT count(*) FROM t HAVING count(*) > 5
----
sql_unsupported

error
SELECT count(*) FROM t LIMIT 1 OFFSET 5
----
sql_unsupported

## A statement asking more questions than one round of fan-out will carry.

error
SELECT sum(amount) FILTER (WHERE amount > 0), sum(amount) FILTER (WHERE amount > 1), sum(amount) FILTER (WHERE amount > 2), sum(amount) FILTER (WHERE amount > 3), sum(amount) FILTER (WHERE amount > 4), sum(amount) FILTER (WHERE amount > 5), sum(amount) FILTER (WHERE amount > 6), sum(amount) FILTER (WHERE amount > 7), sum(amount) FILTER (WHERE amount > 8), sum(amount) FILTER (WHERE amount > 9), sum(amount) FILTER (WHERE amount > 10), sum(amount) FILTER (WHERE amount > 11), sum(amount) FILTER (WHERE amount > 12), sum(amount) FILTER (WHERE amount > 13), sum(amount) FILTER (WHERE amount > 14), sum(amount) FILTER (WHERE amount > 15), sum(amount) FILTER (WHERE amount > 16) FROM t
----
sql_too_many_aggregates

## An output format this surface does not write.

error
SELECT count(*) FROM t FORMAT Arrow
----
