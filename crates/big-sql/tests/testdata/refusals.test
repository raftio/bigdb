# What this surface refuses, and the code each refusal carries.
#
# **The refusal list is the feature.** Somebody who writes a join has a question, and "syntax
# error" does not tell them the engine has no joins to give - so every refusal here carries a
# stable code and a sentence saying what exists instead. The codes are what a client branches
# on, so they are what this file pins; the sentences are checked where they are written.
#
# The reasons have collapsed into a few. Outer joins, rows of a join, window functions,
# `groupArray`, `SELECT *` with values - every one of them asks for **a row**, and a record here
# is a set of bits at `(row, record)` with no row of values to hand back. That is not
# engineering time; it is the shape of the index.

## A join is one equality between two keyed columns two tables share.

error
SELECT count(*) FROM t, u
----
sql_no_joins

# A cross join and a natural join name no key to pair on, which is what a comma between tables
# is - so they carry that refusal rather than the outer join one, whose sentence is about
# producing a row for a record with no partner.
error
SELECT count(*) FROM t CROSS JOIN u
----
sql_no_joins

error
SELECT count(*) FROM t NATURAL JOIN u
----
sql_no_joins

# A third table is answered when it is the same star - every table keyed on the one column they
# all share. The *chain*, where one table would have to be grouped by two columns at once, is
# refused as `sql_no_joins` too; it is not recorded here, and `translate/refusals.rs` is where it
# is asserted.

# An `ON` has to name the table it is joining in. Two tables already in scope is a condition
# about neither of the tables this `JOIN` is about, and a table further down the list is a name
# that is not in scope where it stands.
error
SELECT count(*) FROM t JOIN u ON t.category = u.category JOIN v ON t.category = u.category
----
sql_join_condition

error
SELECT count(*) FROM t JOIN u ON t.category = v.category JOIN v ON t.category = v.category
----
sql_join_condition

error
SELECT count(*) FROM t LEFT JOIN u ON t.category = u.category
----
sql_no_outer_joins

error
SELECT count(*) FROM t RIGHT JOIN u ON t.category = u.category
----
sql_no_outer_joins

error
SELECT count(*) FROM t FULL OUTER JOIN u ON t.category = u.category
----
sql_no_outer_joins

error
SELECT count(*) FROM t JOIN u ON t.category = u.category AND t.country = u.country
----
sql_join_condition

error
SELECT count(*) FROM t JOIN u USING (category)
----
sql_join_condition

error
SELECT count(*) FROM t JOIN u ON t.category > u.category
----
sql_join_condition

## With a join in the statement every column has to say which table it belongs to: the
## translation resolves names before it ever sees a schema, so there is nothing here to guess
## with.

error
SELECT sum(amount) FROM t JOIN u ON t.category = u.category
----
sql_ambiguous_column

error
SELECT count(*) FROM t a JOIN u b ON a.category = b.category WHERE amount > 5
----
sql_ambiguous_column

error
SELECT sum(x.amount) FROM t a JOIN u b ON a.category = b.category
----
sql_ambiguous_column

## A predicate over a join has to be answerable on one side: the two sides are counted
## separately and only meet per key.

error
SELECT count(*) FROM t a JOIN u b ON a.category = b.category WHERE a.amount > 1 OR b.amount > 1
----
sql_join_filter

## Over a join this surface answers count, sum, min, max, avg and the shared-key count. What it
## has no answer for is a *row* of one: a pair of records has no identity this engine stores.

error
SELECT * FROM t a JOIN u b ON a.category = b.category
----
sql_unsupported

## An ordering the answer has no value to sort on.

error
SELECT category, count(*) FROM t GROUP BY category ORDER BY country
----
sql_unsupported_order

error
SELECT count(*) FROM t ORDER BY count(*) DESC
----
sql_unsupported_order

error
SELECT * FROM t ORDER BY amount
----
sql_unsupported_order

## There is no null here, so there is nothing for `IS NULL` to be true of.

error
SELECT count(*) FROM t WHERE amount IS NULL
----
sql_no_nulls

error
SELECT count(*) FROM t WHERE amount IS NOT NULL
----
sql_no_nulls

error
SELECT count(*) FROM t WHERE amount = NULL
----
sql_no_nulls

error
SELECT *, count(*) FROM t
----
sql_unsupported

## `UNION` removes duplicate rows, and a row here is a rendered answer rather than a stored
## tuple.

error
SELECT count(*) FROM t UNION SELECT count(*) FROM u
----
sql_union

error
SELECT count(*) FROM t UNION DISTINCT SELECT count(*) FROM u
----
sql_union

error
SELECT count(*) FROM t INTERSECT SELECT count(*) FROM u
----
sql_unsupported

error
SELECT count(*) FROM t EXCEPT SELECT count(*) FROM u
----
sql_unsupported

## A quantile level is a fraction between zero and one, to three digits - which is the
## resolution the search works in. `0` and `1` are the ends of that range and are accepted; a
## whole number that is neither is not a fraction at all.

error
SELECT quantile(1.5)(amount) FROM t
----
sql_quantile_level

error
SELECT quantile(2)(amount) FROM t
----
sql_quantile_level

error
SELECT quantile(0.5555)(amount) FROM t
----
sql_quantile_level

error
SELECT quantile(amount) FROM t
----
sql_quantile_level

## Writes this surface does not take, and the statements that are not questions.

error
UPDATE t SET amount = 1
----
sql_read_only

error
DELETE FROM t WHERE amount > 5
----
sql_read_only

error
TRUNCATE TABLE t
----
sql_read_only

error
INSERT INTO t (amount) SELECT amount FROM u
----
sql_unsupported

## An `INSERT` whose tuples do not match its column list.

error
INSERT INTO t (_record_id, country) VALUES (1, 'GB', 2)
----
parse_error

error
INSERT INTO t (_record_id, country) VALUES (1)
----
parse_error

error
INSERT INTO t VALUES (1, 'GB')
----
sql_insert_shape

error
INSERT INTO t (_record_id) VALUES ('seven')
----
sql_insert_shape

error
INSERT INTO t (_record_id) VALUES (1.5)
----
sql_insert_shape

error
INSERT INTO t (_record_id) VALUES (-1)
----
sql_insert_shape

## The reserved record column cannot be declared as a field: an `INSERT` could never fill it.

error
CREATE TABLE t (_record_id UINT(32))
----
sql_id_column

error
CREATE TABLE t (a SET, _RECORD_ID INT)
----
sql_id_column

error
ALTER TABLE t ADD COLUMN _record_id UINT(32)
----
sql_id_column


## Views and the objects this engine does not have.
##
## Databases are no longer among them - see `database.test`. What is still refused is a
## *session*: `POST /sql` answers one statement and keeps nothing, so the database is per
## request rather than something `USE` can leave behind.

error
USE sales
----
sql_use_unsupported

## A column is qualified by an alias and nothing else, so a third part is one name too many.
## Two would make `a.b` ambiguous between "alias a, column b" and "database a, table b", and
## the select list is parsed before `FROM` - so there is nothing here to disambiguate with.

error
SELECT sales.orders.amount FROM sales.orders
----
sql_ambiguous_column

error
SELECT count(*) FROM sales.orders.extra
----
sql_ambiguous_column

## A plain view is answered now - see `view.test`. What is still refused is the materialised
## half, which is not a name for a statement but a table plus a promise to keep it current.

error
CREATE MATERIALIZED VIEW v AS SELECT count(*) FROM t
----
sql_no_materialized_views

error
DROP MATERIALIZED VIEW v
----
sql_no_materialized_views

error
ALTER MATERIALIZED VIEW v REFRESH
----
sql_no_materialized_views

## `ALTER VIEW` is not among them either, and gets the ordinary write refusal: a view carries a
## name and a statement, and `CREATE OR REPLACE VIEW` says the statement - so there is nothing
## left for an `ALTER` to reach.

error
ALTER VIEW v AS SELECT a FROM t
----
sql_read_only

error
CREATE INDEX i ON t (a)
----
sql_read_only

error
SHOW INDEX FROM t
----
parse_error

## A field's bit planes *are* its depth and its kind decides how every fact in it was routed, so
## altering either would mean rewriting every fact ever written to it.

error
ALTER TABLE t MODIFY a BIGINT
----
sql_no_alter_column

error
ALTER TABLE t MODIFY COLUMN a BIGINT
----
sql_no_alter_column

error
ALTER TABLE t ALTER COLUMN a TYPE BIGINT
----
sql_no_alter_column

error
ALTER TABLE t CHANGE a b BIGINT
----
sql_no_alter_column

error
ALTER TABLE t RENAME TO u
----
sql_no_rename

error
ALTER TABLE t RENAME COLUMN a TO b
----
sql_no_rename

error
ALTER TABLE t ENGINE = columnar
----
sql_no_alter_engine

# A database carries a name and nothing else, so there is nothing about one to alter.
error
ALTER DATABASE d RENAME TO e
----
sql_read_only

## Constraints, and the widths that are not bit depths.

error
CREATE TABLE t (a INT NOT NULL)
----
sql_no_constraints

error
CREATE TABLE t (a INT NULL)
----
sql_no_constraints

error
CREATE TABLE t (a INT DEFAULT 0)
----
sql_no_constraints

error
CREATE TABLE t (a TEXT COMMENT 'why')
----
sql_no_constraints

error
CREATE TABLE t (a INT PRIMARY KEY)
----
sql_no_constraints

error
CREATE TABLE t (a INT UNIQUE)
----
sql_no_constraints

error
CREATE TABLE t (a INT CHECK (a > 0))
----
sql_no_constraints

error
CREATE TABLE t (a INT AUTO_INCREMENT)
----
sql_no_constraints

error
CREATE TABLE t (a INT REFERENCES u (b))
----
sql_no_constraints

error
ALTER TABLE t ADD PRIMARY KEY (a)
----
sql_no_constraints

error
ALTER TABLE t ADD CONSTRAINT c CHECK (a > 0)
----
sql_no_constraints

error
ALTER TABLE t ADD INDEX i (a)
----
sql_no_constraints

# A length on a key bounds nothing: keys are stored whole, with nothing to truncate.
error
CREATE TABLE t (a VARCHAR(255))
----
sql_no_constraints

# A display width is not a bit depth. `INT(11)` is eleven digits where it was written and would
# be eleven bits here, which stops at 2047 - so it is refused, not reinterpreted.
error
CREATE TABLE t (a INT(11))
----
sql_unknown_column_type

error
CREATE TABLE t (a BIGINT(20))
----
sql_unknown_column_type

## Types with no field kind behind them.

error
CREATE TABLE t (a FLOAT)
----
