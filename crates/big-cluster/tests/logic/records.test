# The two answers that are about records rather than about counts of them, and the formats they
# can be written in.

statement
CREATE TABLE tx (amount UINT(32), price DECIMAL(10, 2), country SET, active BOOL)

statement
INSERT INTO tx (_record_id, amount, price, country, active) VALUES
  (1, 100, 1.50, 'GB', true),
  (2, 900, 12.25, 'US', false),
  (3, 500, 3.00, 'GB', true),
  (4, 700, 7.75, 'FR', true)

# `SELECT *` is every column the table declares, in the order the column list declared them.
# The statement is written before anything knows the table, so both halves of the answer are
# filled in against the schema: the plan reads the columns and the header names them, out of one
# expansion so they cannot disagree.
query
SELECT * FROM tx
----
amount  price  country  active
100     1.50   GB       1
900     12.25  US       0
500     3.00   GB       1
700     7.75   FR       1

query
SELECT * FROM tx WHERE country = 'GB'
----
amount  price  country  active
100     1.50   GB       1
500     3.00   GB       1

query
SELECT * FROM tx WHERE active = true AND amount >= 500
----
amount  price  country  active
500     3.00   GB       1
700     7.75   FR       1

query
SELECT * FROM tx LIMIT 2
----
amount  price  country  active
100     1.50   GB       1
900     12.25  US       0

# Reading values back is what it costs: a record's value in a bit-sliced field is not stored
# anywhere as a number, so reconstructing it is one bit per plane per record per column. A
# `LIMIT` bounds that, and without one the statement asks for every match.
query
SELECT amount FROM tx LIMIT 10
----
amount
100
900
500
700

query
SELECT amount, price FROM tx LIMIT 10
----
amount  price
100     1.50
900     12.25
500     3.00
700     7.75

query
SELECT price, amount FROM tx LIMIT 10
----
price  amount
1.50   100
12.25  900
3.00   500
7.75   700

query
SELECT amount AS a FROM tx LIMIT 2
----
a
100
900

query
SELECT amount FROM tx WHERE country = 'GB' LIMIT 10
----
amount
100
500

# A record holding no value in the column reads as nothing rather than as zero, which is the
# difference between "no fact was written" and "zero was written".
statement
INSERT INTO tx (_record_id, country) VALUES (5, 'DE')

query
SELECT amount FROM tx LIMIT 10
----
amount
100
900
500
700
NULL

# A record that holds no value in a column is still a row of the answer: `SELECT *` is every
# match, and an absent fact reads as nothing rather than dropping the record.
query
SELECT * FROM tx
----
amount  price  country  active
100     1.50   GB       1
900     12.25  US       0
500     3.00   GB       1
700     7.75   FR       1
NULL    NULL   DE       NULL

# The formats, which change the bytes and nothing about the answer. What this corpus checks is
# the answer, so every one of them prints the same cells - the bytes are `big-http`'s to check,
# and it does.
query
SELECT country, count(*) FROM tx GROUP BY country FORMAT TSV
----
country  count
DE       1
FR       1
GB       2
US       1

query
SELECT country, count(*) FROM tx GROUP BY country FORMAT CSVWithNames
----
country  count
DE       1
FR       1
GB       2
US       1

query
SHOW TABLES FORMAT TSV
----
name  type        engine           fields
tx    BASE TABLE  bitmap+columnar  4
