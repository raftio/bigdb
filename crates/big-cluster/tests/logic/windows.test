# Window functions over real records, through the fan-out and the merge.
#
# **The claim is that a partition is whole.** A window runs at the coordinator over the rows every
# shard contributed, because a partition is every row sharing a value and no single node holds
# all of them. These records are spread across shards by record id, so a `row_number()` that ran
# per node would number each shard's rows from one and these cases would say so.
#
# The rows come out in record order - a window fills cells, it does not sort the answer - so a
# rank of 1 can appear on any line. That is worth seeing rather than hiding behind a sort.

statement
CREATE TABLE tx (amount UINT(32), country SET)

statement
INSERT INTO tx (_record_id, amount, country) VALUES
  (1, 100, 'GB'),
  (2, 900, 'US'),
  (3, 500, 'GB'),
  (4, 700, 'FR'),
  (5, 200, 'US'),
  (6, 300, 'GB')

# Numbered across every record: 100 is first, 900 is last.
query
SELECT amount, row_number() OVER (ORDER BY amount) FROM tx
----
amount  row_number
100     1
900     6
500     4
700     5
200     2
300     3

# Per country. GB holds 100, 300, 500 and numbers them 1, 2, 3 wherever they sit in the answer.
query
SELECT country, amount, row_number() OVER (PARTITION BY country ORDER BY amount) FROM tx
----
country  amount  row_number
GB       100     1
US       900     2
GB       500     3
FR       700     1
US       200     1
GB       300     2

# Descending, which is the ranking a dashboard writes.
query
SELECT country, amount, rank() OVER (PARTITION BY country ORDER BY amount DESC) FROM tx
----
country  amount  rank
GB       100     3
US       900     1
GB       500     1
FR       700     1
US       200     2
GB       300     2

# The previous row's value in the ordering, absent at the start.
query
SELECT amount, lag(amount) OVER (ORDER BY amount) FROM tx
----
amount  lag
100     NULL
900     700
500     300
700     500
200     100
300     200

# The partition's total, repeated on every row of it - and the fold has to happen after the merge,
# because GB's three records need not live on one shard.
query
SELECT country, amount, sum(amount) OVER (PARTITION BY country) FROM tx
----
country  amount  sum
GB       100     900
US       900     1100
GB       500     900
FR       700     700
US       200     1100
GB       300     900

query
SELECT country, count(*) OVER (PARTITION BY country) FROM tx
----
country  count
GB       3
US       2
GB       3
FR       1
US       2
GB       3

# The partition's first and last, which with no frame is what the names say.
query
SELECT country, amount, first_value(amount) OVER (PARTITION BY country ORDER BY amount), last_value(amount) OVER (PARTITION BY country ORDER BY amount) FROM tx
----
country  amount  first_value  last_value
GB       100     100          500
US       900     200          900
GB       500     100          500
FR       700     700          700
US       200     200          900
GB       300     100          500

# A window reads a column the answer never shows: this partitions by country and prints neither
# country nor the ordering column.
query
SELECT amount, row_number() OVER (PARTITION BY country ORDER BY amount) FROM tx
----
amount  row_number
100     1
900     2
500     3
700     1
200     1
300     2

# Under a `WHERE`: the window ranks what the filter left, not the table.
query
SELECT amount, row_number() OVER (ORDER BY amount) FROM tx WHERE amount >= 300
----
amount  row_number
900     4
500     2
700     3
300     1

# **The cut, after the window has numbered every row.** The two rows kept carry numbers from a
# ranking over all six - a `LIMIT` that had ridden in the plan would have left four records
# unread and these numbers would be wrong.
query
SELECT amount, row_number() OVER (ORDER BY amount DESC) FROM tx LIMIT 2
----
amount  row_number
100     6
900     1
