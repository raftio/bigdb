# Floats and dates, end to end: declared, written, compared, ordered, aggregated and read back.
#
# The values are chosen to sum exactly in binary - halves and quarters - so that what these cases
# assert is the engine's arithmetic and not a decimal spelling of a rounding error. A float total
# is folded from values rather than counted off the bit planes, and float addition is not
# associative, so a case whose expected block depended on fold order would be a case that failed
# the day a shard count changed.

statement
CREATE TABLE m (temp FLOAT, precise DOUBLE, d DATE, ts DATETIME, label SET)

statement
INSERT INTO m (_record_id, temp, precise, d, ts, label) VALUES
  (1, -3.5, 1.25, '2024-01-15', '2024-01-15 10:30:00', 'a'),
  (2, 0.5, 2.5, '2023-12-31', '2023-12-31 23:59:59', 'b'),
  (3, 2.25, -0.75, '2024-02-29', '2024-02-29 00:00:00', 'a'),
  (4, 10.0, 100.0, '1969-12-31', '1969-12-31 12:00:00', 'b')

# Everything reads back as what was written. A date is a date and not the count of days it is
# stored as, and a float keeps its fractional part rather than arriving as an integer.
query
SELECT * FROM m
----
temp  precise  d           ts                   label
-3.5  1.25     2024-01-15  2024-01-15 10:30:00  a
0.5   2.5      2023-12-31  2023-12-31 23:59:59  b
2.25  -0.75    2024-02-29  2024-02-29 00:00:00  a
10    100      1969-12-31  1969-12-31 12:00:00  b

# Named columns rather than `*`, which is a different path through the planner and not a
# cosmetic variation on the one above: `SELECT *` expands and returns before the per-column
# check that an explicit list goes through. A float column was refused by that check while `*`
# over the same table answered, so this case is here to keep the two honest.
query
SELECT temp, d FROM m
----
temp  d
-3.5  2024-01-15
0.5   2023-12-31
2.25  2024-02-29
10    1969-12-31

# A range over a float is an ordinary bitmap range scan: the encoding is monotonic, so negatives
# order below positives rather than above them, which the raw IEEE bits would have got wrong.
query
SELECT count(*) FROM m WHERE temp < 0
----
count
1

query
SELECT count(*) FROM m WHERE temp >= 0.5 AND temp < 10
----
count
2

query
SELECT count(*) FROM m WHERE precise < 0
----
count
1

# A date before the epoch is an ordinary value, not a missing one. This is the case that would
# fail if a date were stored unsigned.
query
SELECT count(*) FROM m WHERE d < '1970-01-01'
----
count
1

query
SELECT count(*) FROM m WHERE d >= '2024-01-01'
----
count
2

# The leap day is a real date, and the day either side of it is not.
query
SELECT count(*) FROM m WHERE d = '2024-02-29'
----
count
1

query
SELECT count(*) FROM m WHERE ts >= '2024-01-15 10:30:00'
----
count
2

# `min` and `max` over a float take the fast path: the extreme of the stored numbers is the
# encoding of the extreme value, so the plane-by-plane narrowing needs no float code at all.
query
SELECT min(temp), max(temp) FROM m
----
min   max
-3.5  10

# A total, folded from the values. -3.5 + 0.5 + 2.25 + 10.0.
query
SELECT sum(temp) FROM m
----
sum
9.25

query
SELECT avg(precise) FROM m
----
avg
25.75

# `min` and `max` over a date read back as dates, which is the whole point of the kind: the
# merge works in counts from the epoch and the reading is applied once, at the end.
query
SELECT min(d), max(d) FROM m
----
min         max
1969-12-31  2024-02-29

query
SELECT min(ts), max(ts) FROM m
----
min                  max
1969-12-31 12:00:00  2024-02-29 00:00:00

# Grouped, so the reading survives a merge rather than only a single-row answer.
query rowsort
SELECT label, max(d), sum(temp) FROM m GROUP BY label
----
label  max         sum
a      2024-02-29  -1.25
b      2023-12-31  10.5

# `sum` over a date is refused rather than answered. There is no date that is the sum of two
# dates, and the number it would produce is a count from the epoch that stands for nothing.
error
SELECT sum(d) FROM m
----
error: operator_not_allowed

# A string that is not a date is named as one, rather than being read as a key or rounded.
error
SELECT count(*) FROM m WHERE d = '2023-02-29'
----
error: bad_date

# A time of day against a `DATE` is refused rather than truncated to midnight: dropping it would
# answer about a different instant from the one that was written.
error
SELECT count(*) FROM m WHERE d = '2024-01-15 10:30:00'
----
error: bad_date

# A `HAVING` compares in the units the field stores, and a threshold that is an integer all the
# way down cannot hold a float. Refused rather than rounded into something next to the question.
error
SELECT label, sum(temp) FROM m GROUP BY label HAVING sum(temp) > 0
----
error: operator_not_allowed

# A date `HAVING` does work, because a count from the epoch is an integer.
query rowsort
SELECT label, max(d) FROM m GROUP BY label HAVING max(d) > '2024-01-01'
----
label  max
a      2024-02-29

# The scalar calls, over the same rows.
#
# `now()` is not pinned here for the obvious reason - it answers a different value every second -
# so what this corpus asserts about it is the part that is stable: every record was written
# before the statement was read.

query
SELECT ts, toDate(ts) FROM m
----
ts                   toDate
2024-01-15 10:30:00  2024-01-15
2023-12-31 23:59:59  2023-12-31
2024-02-29 00:00:00  2024-02-29
1969-12-31 12:00:00  1969-12-31

# A truncated timestamp is still a timestamp, at midnight. The 1969 row is the one that would
# catch a truncation that rounded towards zero instead of down.
query
SELECT date_trunc('month', ts) FROM m
----
date_trunc('month')
2024-01-01 00:00:00
2023-12-01 00:00:00
2024-02-01 00:00:00
1969-12-01 00:00:00

# Over a column of whole days the rounding stays in days and never goes through seconds.
query
SELECT date_trunc('quarter', d) FROM m
----
date_trunc('quarter')
2024-01-01
2023-10-01
2024-01-01
1969-10-01

query
SELECT count(*) FROM m WHERE ts < now()
----
count
4

# A rounding over a column that holds no moment, refused where the schema is - the parser could
# not have known what `label` was.
error
SELECT toDate(label) FROM m
----
error: bad_rounding

# And a boundary finer than the column's own unit.
error
SELECT date_trunc('hour', d) FROM m
----
error: bad_rounding
