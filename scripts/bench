#!/usr/bin/env bash
#
# One entry point for every benchmark in this repo, so a run on a fresh VPS is one line.
#
#   ./scripts/bench load 10000000        # where the time in a load goes
#   ./scripts/bench profile 3000000      # which symbols the daemon spends it in
#   ./scripts/bench olap 1000000         # the analytical comparison
#   ./scripts/bench storage              # the write-amplification report
#   ./scripts/bench all 1000000
#
# Every command writes both to the terminal and to results/<command>-<stamp>.txt, together
# with the machine it ran on. A benchmark number without the machine under it is not a result.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

results="${BENCH_RESULTS:-$root/bench/results}"

# A tree that arrived over rsync carries the uid it had on the other machine, and git refuses to
# read a repository owned by somebody else - which on the remote side turns every `ab` into
# "HEAD is not a commit". Declared for this process only, through the environment rather than by
# writing to the user's global git config: a benchmark script does not get to leave settings
# behind on a machine it visited once.
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=safe.directory
export GIT_CONFIG_VALUE_0="$root"

# `olap` compares against DuckDB, DataFusion and ClickHouse. They are optional because DuckDB
# alone is minutes and gigabytes of compile, so nothing pays for them unless it asks.
peers="${BENCH_PEERS:-}"

red()  { printf '\033[31m%s\033[0m\n' "$*" >&2; }
note() { printf '\033[2m%s\033[0m\n' "$*" >&2; }

usage() {
  sed -n '3,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  cat <<'USAGE'

Commands
  load [RECORDS] [SHARDS] [REPEAT]
                            Load-path profile. RECORDS defaults to 1000000. SHARDS defaults to
                            0, meaning dense ids; any other value spreads them that wide, which
                            is the axis this engine is most sensitive to. REPEAT defaults to 3
                            and reports the fastest run; on a box with nothing else on it, 1.
  ab [RECORDS] [SHARDS] [REPEAT]
                            The same profile against the working tree and against a base
                            revision (BENCH_BASE, default HEAD), and the difference between
                            them. This is the command that answers "did the change help".
  olap [RECORDS]            The analytical report. Set BENCH_PEERS=olap-peers to include
                            DuckDB, DataFusion and ClickHouse.
  profile [RECORDS] [SHARDS]
                            The same import as `server`, under `perf`, and the symbol table
                            that comes out of it. Answers "which line is the time in", where
                            `load` and `server` only answer "how long". Linux and perf only;
                            it says so rather than half-working. Keeps the raw perf.data
                            beside the report so it can be re-read with other options.
  server [RECORDS] [SHARDS] Import over HTTP: starts big serve, drives it with bigctl, and times the
                            whole road - line parse, batch, one commit per request, round trip.
                            Loads the identical records into ClickHouse beside it when one is
                            listening, with the page cache dropped between the two. Tears down
                            the daemon, both tables and the data directory afterwards.
  storage                   The storage report: write amplification, capacity sweep, size.
  compare                   The criterion read sweep against redb, lmdb, sqlite, fjall.
  all [RECORDS]             load, then storage, then olap.
  env                       Print the machine and toolchain, and check the disk has room.
  remote CMD [ARGS...]      Run any of the above on BENCH_HOST instead of here: copies the
                            working tree over, runs it there, brings the report back. The
                            machine recorded in the report is the remote one, which is the
                            whole point. Needs a rust toolchain on the far side; it says so
                            rather than installing one. The run is detached, so a dropped
                            connection does not take it with it:
                              remote --attach   follow the log again
                              remote --status   is it still going, and where is it
                              remote --stop     kill it
                              remote --fetch    pull the reports back without watching

Environment
  BENCH_RESULTS   Where reports are written. Default bench/results.
  BENCH_PEERS     Cargo features for `olap`. Default none. Use `olap-peers` for all of them.
  BENCH_KEEP      Set to keep what `server` creates: the daemon's data directory and the daemon
                  itself, so the corpus can be queried after the load. Off by default, because
                  otherwise every run leaves a database and a process behind on the box.
  BENCH_FOLLOW    Set to 0 to start a remote run and not watch it. Default 1.
  BENCH_ENGINE    Table engine `server` creates: bitmap, bitmap+columnar or columnar.
                  Default bitmap - the index and no column segments, which is half the write
                  path. Recorded in the report, because it changes what the number means.
  BENCH_DURABILITY  What `server` starts the daemon with: full, barrier or none. Default full.
  BENCH_IN_FLIGHT Requests `bigctl` keeps waiting on the server. Default 2 - `bigctl`'s own -
                  ceiling 8. The second lets the server parse one body while it commits the
                  last, worth about 1.6x; it does not make writes concurrent, and it changes
                  how much a resumed load repeats.
  BENCH_CLICKHOUSE  Where `server` looks for a ClickHouse to load beside big. Default
                  http://127.0.0.1:8123. Not reachable means the row is skipped and says so.
  BENCH_PROFILE_FREQ   Samples per second `profile` asks perf for. Default 299 - a prime, so
                  it cannot beat against anything periodic in the workload.
  BENCH_PROFILE_LIMIT  Symbols below this percentage are left out of the report. Default 0.6.
  BENCH_CHUNK     Bytes per import request. Default 7340032; the ceiling is 8388608. The
                  runbook calls this the throughput knob, because the server commits once
                  per request.
  BENCH_BUILD     `remote` (default) compiles on the far side. `cross` compiles here for
                  BENCH_TARGET and ships the binaries, which turns a four-minute build on a
                  two-vCPU droplet into seconds on a laptop. Needs zig and cargo-zigbuild;
                  it says exactly what is missing rather than half-working.
  BENCH_TARGET    What `cross` builds for. Default x86_64-unknown-linux-gnu.
  BENCH_BASE      What `ab` compares the working tree against. Default HEAD.
  BENCH_HOST      Where `remote` runs. An ssh destination: a Host from ~/.ssh/config, or
                  user@address. No default - a benchmark that picks its own machine is a
                  benchmark you cannot attribute.
  BENCH_REMOTE_DIR  Where the tree lands on the far side. Default ~/bench-<repo name>.
USAGE
}

machine() {
  echo "## machine"
  echo
  echo "date          $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  echo "host          $(hostname)"
  case "$(uname -s)" in
    Linux)
      echo "os            $(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME" || uname -sr)"
      echo "kernel        $(uname -r)"
      echo "cpu           $(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo) x $(nproc)"
      echo "memory        $(awk '/MemTotal/{printf "%.1f GiB", $2/1048576}' /proc/meminfo)"
      # What the file lands on decides half of any write benchmark, so it is recorded.
      echo "disk          $(df -h "$root" | awk 'NR==2{print $2" total, "$4" free, on "$1}')"
      ;;
    Darwin)
      echo "os            macOS $(sw_vers -productVersion)"
      echo "cpu           $(sysctl -n machdep.cpu.brand_string) x $(sysctl -n hw.ncpu)"
      echo "memory        $(echo "$(sysctl -n hw.memsize)/1073741824" | bc) GiB"
      echo "disk          $(df -h "$root" | awk 'NR==2{print $2" total, "$4" free"}')"
      # Worth stating outright: it makes every fsync figure on macOS incomparable with Linux.
      echo "note          macOS full durability issues F_FULLFSYNC, which is milliseconds"
      ;;
  esac
  echo "rustc         $(rustc --version)"
  echo "target-cpu    ${RUSTFLAGS:-<unset>}"
  echo
}

# Refusing up front beats dying at minute nine of a fourteen-minute run.
#
# The second argument is how many bytes of RAM one record costs the command about to run, which
# is not the same for all of them:
#
#   load, ab   0   the corpus streams; each record is computed, used and dropped. `profile_load`
#                  works out its own ceiling for `bulk_load`, which is the one path inside it
#                  that still holds everything.
#   olap       36  the analytical comparison checks every answer against a materialised ground
#                  truth, so it needs the whole corpus in memory: 32 bytes for the record and 4
#                  for its category. A billion records is 36 GiB before a byte is written, and
#                  the way that failure presents is the OOM killer half an hour in.
check_room() {
  local records="$1" bytes_per_record="${2:-0}"

  # Measured, not guessed: a dense million records is 9 MiB of file at capacity 1M and 14 at
  # 100k, so 20 covers the widest variant with room to spare. Plus a couple of gigabytes for
  # the build itself, which a fresh box has not done yet.
  local want_gib free_gib
  want_gib=$(( (records / 1000000 * 20) / 1024 + 3 ))
  free_gib=$(df -Pk "$root" | awk 'NR==2{print int($4/1048576)}')
  if [ "$free_gib" -lt "$want_gib" ]; then
    red "not enough disk: ${records} records wants about ${want_gib} GiB, ${free_gib} GiB free"
    exit 1
  fi

  local avail_mib
  case "$(uname -s)" in
    Linux)  avail_mib=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo) ;;
    Darwin) avail_mib=$(( $(sysctl -n hw.memsize) / 1048576 )) ;;
    *)      avail_mib=0 ;;
  esac

  if [ "$bytes_per_record" -eq 0 ]; then
    note "need ~${want_gib} GiB disk (${free_gib} free); corpus streams, so RAM is not the limit"
    return
  fi

  local want_mib
  want_mib=$(( records / 1048576 * bytes_per_record ))
  note "need ~${want_gib} GiB disk (${free_gib} free), ~${want_mib} MiB RAM for the corpus (${avail_mib} MiB available)"
  if [ "$avail_mib" -gt 0 ] && [ "$want_mib" -gt $(( avail_mib * 7 / 10 )) ]; then
    red "not enough memory: the corpus alone wants ~$((want_mib / 1024)) GiB, this box has $((avail_mib / 1024)) GiB available"
    red "the ceiling here is about $(( avail_mib * 7 / 10 / bytes_per_record * 1048576 / 1000000 )) million records"
    exit 1
  fi
}

build() {
  if [ -n "${BENCH_NO_BUILD:-}" ]; then
    note "using the binaries already in target/release (BENCH_NO_BUILD)"
    return
  fi
  note "building --release (first build on a fresh box takes a few minutes)"
  cargo build --release "$@" >&2
}

# Runs a command, showing it live and keeping a copy with the machine written above it.
capture() {
  local name="$1"; shift
  mkdir -p "$results"
  local out="$results/$name-$(date -u '+%Y%m%dT%H%M%SZ').txt"
  { machine; } > "$out"
  note "writing $out"
  "$@" 2>&1 | tee -a "$out"
  note "done: $out"
}

cmd_load() {
  local records="${1:-1000000}" shards="${2:-0}" repeat="${3:-3}"
  check_room "$records" 0
  build -p big-bench --bin profile_load
  capture "load" ./target/release/profile_load "$records" "$shards" "$repeat"
}

cmd_olap() {
  local records="${1:-200000}"
  check_room "$records" 36
  if [ -n "$peers" ]; then
    note "peers: $peers (DuckDB bundles a C++ tree; the first build is long)"
    build -p big-bench --bin olap --features "$peers"
  else
    note "no peers: set BENCH_PEERS=olap-peers to compare against DuckDB/DataFusion/ClickHouse"
    build -p big-bench --bin olap
  fi
  capture "olap" ./target/release/olap "$records"
}

cmd_storage() {
  build -p big-bench --bin report
  capture "storage" ./target/release/report
}

cmd_compare() {
  note "criterion sweep; this one takes a while by design"
  capture "compare" cargo bench -p big-bench --bench compare
}

# The working tree against a base revision, on the same box, minutes apart.
#
# The base is built from a throwaway worktree rather than by stashing: a stash that fails to pop
# because a build errored in between is a way to lose work, and no benchmark is worth that. The
# worktree gets its own target directory for the same reason it gets its own checkout - sharing
# one would make each half rebuild what the other half just replaced, and the timings would then
# include a rebuild rather than a load.
#
# That target directory outlives the run, unlike the worktree. It is the expensive half - ten
# minutes of cold build on two vCPUs - and it is reusable whenever the base has not moved, which
# for a base of HEAD is most of the time. Delete `target-base/` to force a clean one.
cmd_ab() {
  local records="${1:-1000000}" shards="${2:-0}" repeat="${3:-3}"
  local base="${BENCH_BASE:-HEAD}"
  check_room "$records" 0

  local why
  if ! why=$(git -C "$root" rev-parse --verify "$base^{commit}" 2>&1); then
    red "cannot resolve BENCH_BASE=$base:"
    red "  $why"
    exit 1
  fi
  local base_sha
  base_sha="$(git -C "$root" rev-parse --short "$base")"

  local tmp
  tmp="$(mktemp -d)"
  # Always removed, including on an interrupt: a leaked worktree makes the next run refuse.
  # Expanded now rather than at exit: `tmp` is a local, and a trap that fires after this
  # function returns would find it gone and die on `set -u` instead of cleaning up.
  # shellcheck disable=SC2064
  trap "git -C '$root' worktree remove --force '$tmp/base' >/dev/null 2>&1 || true; rm -rf '$tmp'" EXIT

  note "base $base_sha -> $tmp/base"
  git -C "$root" worktree add --detach "$tmp/base" "$base" >&2

  # **The whole harness is copied in, not just the binary.** The profiler must be the same
  # program on both sides or the comparison measures the profiler - and the profiler is not
  # self-contained: it draws its corpus from `bench/src/wide.rs`. Copying the binary alone
  # meant a base revision that predated a change to the generator could not even compile it,
  # and a base that *could* would have been fed a different corpus, which is worse: it would
  # have produced two plausible columns measuring two different workloads.
  #
  # So `bench/` comes from the working tree on both sides and `crates/` does not. What the two
  # columns differ by is then exactly the engine, which is the question `ab` is asked.
  rsync -a --delete --exclude 'results/' "$root/bench/" "$tmp/base/bench/"

  note "building base"
  ( cd "$tmp/base" && CARGO_TARGET_DIR="$root/target-base" cargo build --release -p big-bench --bin profile_load >&2 )
  note "building working tree"
  build -p big-bench --bin profile_load

  mkdir -p "$results"
  local out="$results/ab-$(date -u '+%Y%m%dT%H%M%SZ').txt"
  { machine; echo "base          $base_sha"; echo "records       $records"; echo; } > "$out"

  note "running base"
  "$root/target-base/release/profile_load" "$records" "$shards" "$repeat" --tsv > "$tmp/base.tsv"
  note "running working tree"
  ./target/release/profile_load "$records" "$shards" "$repeat" --tsv > "$tmp/head.tsv"

  {
    echo "## working tree vs $base_sha  ($records records, best of $repeat)"
    echo
    paste "$tmp/base.tsv" "$tmp/head.tsv" | awk -F'\t' '
      BEGIN { printf "%-46s %14s %14s %10s\n", "path", "base facts/s", "new facts/s", "change" }
      {
        base = $3 + 0; new = $6 + 0;
        change = base > 0 ? (new / base - 1) * 100 : 0;
        printf "%-46s %14d %14d %+9.1f%%\n", $1, base, new, change
      }'
    echo
    echo "Positive is faster. A change under about 5% on a shared vCPU is inside the noise;"
    echo "run it again before believing it."
  } | tee -a "$out"
  note "done: $out"
}


# The same commands, on another machine.
#
# **It copies rather than clones.** The point is to measure the tree in front of you, including
# whatever is uncommitted in it - a remote that pulled from a branch would measure something you
# would then have to go and look up. `.git` goes too, because `ab` needs it to build the base.
#
# Nothing is installed on the far side. A missing toolchain is reported, not fixed: silently
# curl-piping rustup into someone's server is not a thing a benchmark script gets to decide.
cmd_remote() {
  local host="${BENCH_HOST:-}"
  if [ -z "$host" ]; then
    red "set BENCH_HOST to an ssh destination, e.g. BENCH_HOST=my-vps ./scripts/bench remote load 10000000"
    exit 1
  fi
  case "${1:-}" in
    --attach|--status|--stop|--fetch) cmd_remote_control "$1"; return ;;
  esac
  if [ $# -eq 0 ]; then
    red "remote needs a command: remote load 10000000"
    exit 1
  fi

  local dir="${BENCH_REMOTE_DIR:-bench-$(basename "$root")}"

  # `ssh host cmd` runs a non-interactive shell, and Ubuntu's ~/.bashrc returns immediately in
  # one - so rustup's PATH line is not read and cargo looks missing on a box that has it. Every
  # remote command therefore sources ~/.cargo/env itself rather than trusting the profile.
  local prelude='. "$HOME/.cargo/env" 2>/dev/null || true;'

  # **The knobs have to travel with the command.** `ssh host cmd` starts a fresh environment, so
  # `BENCH_DURABILITY=none ./scripts/bench remote server ...` set a variable on the laptop and
  # ran the default on the server - the run reported `durability full` in its own header and
  # nobody reading the terminal would have caught it. Every knob the far side reads is forwarded
  # explicitly; the ones that describe *this* side (HOST, BUILD, TARGET, FOLLOW) are not, because
  # they mean nothing over there.
  local var
  for var in BENCH_ENGINE BENCH_DURABILITY BENCH_CHUNK BENCH_IN_FLIGHT BENCH_CLICKHOUSE BENCH_BIGD_ADDR \
             BENCH_KEEP BENCH_PEERS BENCH_BASE BENCH_PROFILE_FREQ BENCH_PROFILE_LIMIT BIG_LOG; do
    if [ -n "${!var:-}" ]; then
      # `export`, not a bare assignment. A plain `VAR=x;` sets a shell variable that the
      # child process never sees, so the forwarding looked right in the terminal and the run
      # used the defaults anyway - caught only because the report prints what it actually used.
      prelude="$prelude export $var=$(printf %q "${!var}");"
      note "forwarding $var=${!var}"
    fi
  done

  note "checking $host"
  if ! ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" "$prelude command -v cargo >/dev/null"; then
    red "no cargo on $host. Install a toolchain there first:"
    # Single-quoted `=https`: in zsh a bare `=word` is filename expansion and the line dies
    # before curl sees it.
    red "  ssh $host \"curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y\""
    exit 1
  fi

  # Cross-built here and shipped, rather than compiled over there.
  #
  # A cold release build of this workspace is four minutes on the two vCPUs that box has and
  # seconds on a laptop, so when the toolchain is present it is worth the shipping. It is not
  # the default because it needs one: the far side is `x86_64-unknown-linux-gnu` and an Apple
  # laptop is `aarch64-apple-darwin`, so this is a genuine cross-compile and rustc cannot link
  # it alone. `cargo-zigbuild` supplies the linker without a container - `cross` would work too
  # and would run an amd64 image under emulation on an ARM host, which is slower than the VPS.
  local prebuilt=""
  if [ "${BENCH_BUILD:-remote}" = "cross" ]; then
    cross_build || exit 1
    prebuilt="yes"
  fi

  note "copying the working tree to $host:$dir"
  # `target` is the big one and is machine-specific anyway; the console and the landing page
  # have nothing to do with a benchmark and node_modules is enormous.
  # `--no-owner --no-group` because `-a` would otherwise preserve this machine's uids, and an
  # rsync running as root on the far side honours them - leaving a tree root cannot call its
  # own. Permissions are kept, because `scripts/bench` has to stay executable.
  rsync -az --delete --no-owner --no-group \
    --exclude 'target/' --exclude 'node_modules/' --exclude '.next/' \
    --exclude 'console/' --exclude 'landing/' --exclude 'bench/results/' \
    -e 'ssh -o BatchMode=yes' \
    "$root/" "$host:$dir/"

  # **Detached, not attached.** A cold build on two vCPUs plus a billion-record load is tens of
  # minutes, and an ssh session does not reliably last that long - a dropped connection, a
  # closed laptop or a client-side timeout would otherwise take the run with it. So the run is
  # started under `setsid nohup`, writes to a log on the far side, and this only *follows* that
  # log. Interrupting the follow is safe; the run keeps going.
  # Two spellings of the same file, and mixing them up is what broke this the first time: the
  # run redirects *after* `cd`, so its path is relative to the repo, while `tail` connects in a
  # fresh session and needs the path from the home directory.
  local logrel="bench/remote.log"
  local log="$dir/$logrel"

  if [ -n "$prebuilt" ]; then
    note "shipping the cross-built binaries"
    ssh -o BatchMode=yes "$host" "mkdir -p '$dir/target/release'"
    rsync -az --no-owner --no-group -e 'ssh -o BatchMode=yes' \
      "$root/target/$BENCH_TARGET/release/big" \
      "$root/target/$BENCH_TARGET/release/bigctl" \
      "$root/target/$BENCH_TARGET/release/facts" \
      "$root/target/$BENCH_TARGET/release/profile_load" \
      "$host:$dir/target/release/"
    prelude="$prelude BENCH_NO_BUILD=1;"
  fi

  note "starting detached run: ./scripts/bench $*"
  # Created before the run is backgrounded, so the `tail` that follows cannot race it and find
  # nothing there. `setsid` puts the run in its own session, which is what makes it survive the
  # ssh going away rather than merely surviving this shell.
  ssh -o BatchMode=yes "$host" \
    "$prelude cd '$dir' && : > '$logrel' && (setsid nohup sh -c './scripts/bench $*; echo $DONE' > '$logrel' 2>&1 < /dev/null &) && echo started"

  if [ "${BENCH_FOLLOW:-1}" = "0" ]; then
    note "started and left running. Watch it with: BENCH_HOST=$host ./scripts/bench remote --attach"
    return
  fi

  note "following $log  (^C stops watching, not the run; re-attach with: remote --attach)"
  follow "$host" "$log"
  fetch_reports "$host" "$dir"
}

# The last line the run writes, so a follower knows to stop.
#
# `tail -f` has no idea what it is following and would sit there for ever after the run ends,
# which turns "watch the bench" into "press ^C when the output stops moving". GNU `tail` has
# `--pid` for exactly this and BSD `tail` does not, so the run announces its own end instead and
# this works wherever `sed` does.
DONE='__bench_done__'

follow() {
  local host="$1" log="$2"
  # `|| true` so a ^C here is not an error: the point is that it detaches cleanly.
  ssh -t "$host" "tail -n +1 -f '$log' | sed -n '/^$DONE\$/q;p'" || true
}

fetch_reports() {
  local host="$1" dir="$2"
  note "bringing reports back to $results"
  mkdir -p "$results"
  rsync -az -e 'ssh -o BatchMode=yes' "$host:$dir/bench/results/" "$results/" 2>/dev/null || true
  note "done"
}

# Re-attach to, check on, or stop a detached run without copying anything again.
cmd_remote_control() {
  local host="${BENCH_HOST:-}"
  if [ -z "$host" ]; then
    red "set BENCH_HOST first"
    exit 1
  fi
  local dir="${BENCH_REMOTE_DIR:-bench-$(basename "$root")}"
  local log="$dir/bench/remote.log"

  case "$1" in
    --attach)
      follow "$host" "$log"
      fetch_reports "$host" "$dir"
      ;;
    --status)
      ssh -o BatchMode=yes "$host" \
        "pgrep -a 'cargo|rustc|profile_load|olap|report|perf|big|bigctl' || echo '(nothing running)'; echo '--- last lines ---'; tail -5 '$log' 2>/dev/null || echo '(no log yet)'; true"
      ;;
    --stop)
      note "stopping the run on $host"
      ssh -o BatchMode=yes "$host" "pkill -f 'scripts/bench'; pkill -f 'profile_load'; pkill -f 'perf record'; pkill cargo; true"
      ;;
    --fetch)
      fetch_reports "$host" "$dir"
      ;;
  esac
}


# The server path, which is the one a user actually meets.
#
# **Why this is a different measurement from `load`, not a slower spelling of it.** `load` calls
# `big-db` as a library. This starts `big serve`, hands `bigctl` the same corpus and times the whole
# road: a line parsed per fact, a batch allocated, one commit per request, and a round trip for
# each 7 MiB of it. Nothing in the in-process number reflects any of that.
#
# It measures `big` and nothing else. Putting a rival in the same run was tried and taken back
# out: two engines loaded back to back on one box share a page cache and a disk queue, and the
# second one is measured through whatever the first one left behind. A comparison worth printing
# needs each side to get a cold box, which is a different command from this one.

# What `BENCH_BUILD=cross` needs, and what to do when it is not there.
BENCH_TARGET="${BENCH_TARGET:-x86_64-unknown-linux-gnu}"

cross_build() {
  local missing=""
  command -v zig >/dev/null || missing="$missing zig"
  cargo zigbuild --version >/dev/null 2>&1 || missing="$missing cargo-zigbuild"
  rustup target list --installed 2>/dev/null | grep -qx "$BENCH_TARGET" || missing="$missing rust-target"

  if [ -n "$missing" ]; then
    red "BENCH_BUILD=cross needs a cross toolchain, and this machine is missing:$missing"
    red ""
    red "  brew install zig"
    red "  cargo install cargo-zigbuild"
    red "  rustup target add $BENCH_TARGET"
    red ""
    red "Or drop BENCH_BUILD and let the far side compile (about four minutes, once)."
    return 1
  fi

  note "cross-building for $BENCH_TARGET"
  cargo zigbuild --release --target "$BENCH_TARGET" \
    --bin big --bin bigctl --bin facts --bin profile_load >&2
}


# Everything `server` created, taken back down in the order that works.
#
# The order is the point: the table is dropped *through the running daemon*, so it goes the way
# it came, before anything is killed. That the file is deleted straight after makes the drop look
# redundant - it is not. `BENCH_KEEP` and a persistent data directory both turn this into the
# only thing standing between one run and the next one loading on top of it.
#
# Best-effort throughout. A cleanup that fails loudly on the way out of a benchmark that
# succeeded is worse than one that quietly leaves a temporary directory: the exit code should
# say what the measurement did.
# Drop what the last load left in the page cache, so the next one starts where it did.
#
# This is what makes two engines measurable on one box at all. Loading back to back without it,
# the second engine reads and writes through a cache the first one warmed and a disk queue it
# left work in - and the second column is then partly a measurement of the first. Root on Linux
# can simply ask the kernel to forget; anywhere else this is a `sync` and an honest note that
# the run is warmer than it should be.
cold_cache() {
  sync
  if [ "$(uname -s)" = "Linux" ] && [ -w /proc/sys/vm/drop_caches ]; then
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
  else
    note "cannot drop the page cache here; the second load starts warmer than the first"
  fi
}

server_cleanup() {
  # First, and outside the `BENCH_KEEP` early return: keeping a database to query is a reason to
  # leave the daemon up, never a reason to leave a profiler attached to it. A `perf record` that
  # outlives its run holds the samples in a buffer nobody will ever ask for and keeps writing.
  if [ -n "${BIGD_PERF_PID:-}" ]; then
    kill -INT "$BIGD_PERF_PID" 2>/dev/null || true
    wait "$BIGD_PERF_PID" 2>/dev/null || true
    BIGD_PERF_PID=""
  fi

  if [ -n "${BENCH_KEEP:-}" ]; then
    note "BENCH_KEEP: leaving ${BIGD_DATA:-the data directory} in place"
    note "  big is still serving on ${BIGD_ADDR:-?} as pid ${BIGD_PID:-?}; kill it when you are done"
    return 0
  fi

  if [ -n "${BIGD_PID:-}" ] && [ -n "${BIGD_ADDR:-}" ] && [ -x ./target/release/bigctl ]; then
    note "dropping table t"
    ./target/release/bigctl drop table t --addr "$BIGD_ADDR" >/dev/null 2>&1 || true
  fi
  # ClickHouse's copy does not go with a temporary directory the way big's does, so if this
  # line is missing the corpus stays on the box for ever. Two runs of twenty million and
  # nobody notices until the disk is full.
  if [ -n "${BENCH_CH_TABLE:-}" ]; then
    note "dropping clickhouse bench_t"
    curl -sS "$BENCH_CH_TABLE/" --data-binary 'DROP TABLE IF EXISTS bench_t' >/dev/null 2>&1 || true
  fi
  if [ -n "${BIGD_PID:-}" ]; then
    kill "$BIGD_PID" 2>/dev/null || true
    wait "$BIGD_PID" 2>/dev/null || true
  fi
  if [ -n "${BIGD_DATA:-}" ]; then
    rm -rf "$BIGD_DATA"
  fi
  return 0
}

# Starts a `big serve` with the benchmark schema on it, and arms the cleanup.
#
# **Shared by `server` and `profile` on purpose.** A profile of one daemon and a throughput
# figure from a differently-configured one are two measurements of two programs, and the
# temptation to let them drift apart is exactly what a second copy of this block would allow.
# Everything either command varies - the engine, the durability, the address - it varies here.
#
# Leaves `BIGD_PID`, `BIGD_ADDR`, `BIGD_DATA`, `BIGD_ENGINE` and `BIGD_DURABILITY` behind, in
# globals rather than locals: the `EXIT` trap runs after the calling function has returned, and
# a `local` would be out of scope by then - which under `set -u` kills the shell with "unbound
# variable" instead of cleaning up. Where the cost is a daemon left holding an exclusive lock on
# a file nobody deletes, that matters.
server_up() {
  # 7655, not `big serve`'s own default of 7654. A box that runs this benchmark is a box likely to
  # have a real daemon on it, and the two must never meet: the bench would refuse to start
  # (see the guard below) or, worse on a machine without that guard, load twenty million
  # records into somebody's actual database and then drop the table.
  BIGD_ADDR="${BENCH_BIGD_ADDR:-127.0.0.1:7655}"
  BIGD_DURABILITY="${BENCH_DURABILITY:-full}"
  # `bitmap`, not the `bitmap+columnar` default. Half the write path: a bitmap table keeps the
  # index and no column segments, so it is the number for an import that exists to be queried
  # as sets rather than scanned. The engine is recorded in the report because it changes what
  # the figure means - comparing a bitmap load against a columnar one is comparing two amounts
  # of work, not two speeds.
  BIGD_ENGINE="${BENCH_ENGINE:-bitmap}"
  BIGD_DATA="$(mktemp -d)"
  BIGD_PID=""
  BIGD_PERF_PID=""
  BENCH_CH_TABLE=""
  trap server_cleanup EXIT

  # **Refuse a port somebody else is on, rather than measure them.**
  #
  # This is not hypothetical: an earlier run of this very command leaked a daemon, and the next
  # run's daemon could not bind, so the health check below was answered by the *previous* build
  # still holding the port. The bench then created its schema on a stranger, loaded a stranger,
  # and reported a number for a binary nobody had asked about. A health probe against an address
  # cannot tell you whose address it is.
  if ./target/release/bigctl health --addr "$BIGD_ADDR" >/dev/null 2>&1; then
    red "something is already answering on $BIGD_ADDR - refusing to measure it"
    red "  it is most likely a big serve left over from an earlier run:"
    red "    pkill -f 'big serve .*$BIGD_ADDR'"
    red "  or point this run elsewhere with BENCH_BIGD_ADDR=127.0.0.1:7656"
    exit 1
  fi

  note "starting big serve on $BIGD_ADDR, durability=$BIGD_DURABILITY, data=$BIGD_DATA"
  # Loopback with no --tokens: auth is disabled, which `big serve` allows only because it cannot be
  # reached from anywhere else. Do not copy this line onto a public interface.
  BIG_LOG="${BIG_LOG:-warn}" ./target/release/big serve "$BIGD_DATA/big.db" "$BIGD_ADDR" \
    --durability "$BIGD_DURABILITY" > "$BIGD_DATA/big serve.log" 2>&1 &
  BIGD_PID=$!

  local ready=""
  for _ in $(seq 1 50); do
    # The process first, the port second. If the daemon we started has exited there is no point
    # asking the address whether it is well - somebody else would answer.
    if ! kill -0 "$BIGD_PID" 2>/dev/null; then
      red "big serve exited before it was ready:"
      sed 's/^/  /' "$BIGD_DATA/big serve.log" >&2
      exit 1
    fi
    if ./target/release/bigctl health --addr "$BIGD_ADDR" >/dev/null 2>&1; then ready=yes; break; fi
    sleep 0.2
  done
  if [ -z "$ready" ]; then
    red "big serve did not come up on $BIGD_ADDR:"
    sed 's/^/  /' "$BIGD_DATA/big serve.log" >&2
    exit 1
  fi

  note "creating the schema"
  local bigctl="./target/release/bigctl --addr $BIGD_ADDR"
  $bigctl create table t --engine "$BIGD_ENGINE" >/dev/null
  $bigctl create field t amount --kind int --bit-depth 20 >/dev/null
  $bigctl create field t category --kind set >/dev/null
  $bigctl create field t country --kind set >/dev/null
  $bigctl create field t active --kind bool >/dev/null
}

cmd_server() {
  local records="${1:-1000000}" shards="${2:-0}"
  check_room "$records" 0
  # Only the four binaries this needs. `-p big-bench` would additionally build `olap`, `report`
  # and three scratch profilers, which drag in the planner, the SQL front end and every rival
  # engine - minutes of compile on two vCPUs for code this command never calls.
  build --bin big --bin bigctl --bin facts
  server_up
  local addr="$BIGD_ADDR" data="$BIGD_DATA"
  local durability="$BIGD_DURABILITY" engine="$BIGD_ENGINE"
  local chunk="${BENCH_CHUNK:-7340032}"
  # `bigctl`'s own default, and it is two: one request in flight is a strictly alternating load
  # where each end waits for the other, and the second is worth about 1.6x. Kept in step with
  # `big_ingest::args::DEFAULT_IN_FLIGHT` rather than pinned here - a benchmark whose default
  # is not the product's default is measuring a configuration nobody runs.
  local in_flight="${BENCH_IN_FLIGHT:-2}"

  # **Decided out here, not inside the reporting block below.** That block is piped into `tee`,
  # which puts it in a subshell - so a variable set inside it is gone by the time the `EXIT`
  # trap runs in this shell. The first version set `BENCH_CH_TABLE` in there and the cleanup
  # never saw it: two hundred thousand rows stayed on the box, silently, exactly the leak the
  # cleanup exists to prevent.
  local ch="${BENCH_CLICKHOUSE:-http://127.0.0.1:8123}"
  local have_ch=""
  if curl -sf --max-time 3 "$ch/ping" >/dev/null 2>&1; then
    have_ch="yes"
    BENCH_CH_TABLE="$ch"
  fi

  mkdir -p "$results"
  local out="$results/server-$(date -u '+%Y%m%dT%H%M%SZ').txt"
  { machine; echo "records       $records"; echo "engine        $engine"; \
    echo "durability    $durability"; echo "chunk-bytes   $chunk"; \
    echo "in-flight     $in_flight"; echo; } > "$out"

  {
    echo "## import over HTTP  ($records records x 4 facts, engine $engine)"
    echo

    note "loading big serve" >&2
    cold_cache
    # **`--progress`, not `--no-progress`.** A twenty-million-record load is minutes of silence
    # otherwise, and silence from a benchmark is indistinguishable from a hang - which is
    # exactly how the first one was read. Not being a terminal, it writes plain lines rather
    # than redrawing one.
    #
    # **stdout is the fact count; everything else is on stderr.** `bigctl import` prints what
    # the server said on stdout, the way every other `bigctl` subcommand does, and what the
    # loop itself did - lines, chunks, bytes, elapsed - on stderr beside the progress. So the
    # numbers below are read from a copy of stderr, and `tee` is what keeps them *also* flowing
    # into the log while the load is still running.
    #
    # `bigctl` reports its own elapsed, which starts when the first byte is sent rather than when
    # this shell got around to launching it.
    local noise
    noise=$(mktemp)
    ./target/release/facts "$records" "$shards" \
      | ./target/release/bigctl import t - --addr "$addr" --chunk-bytes "$chunk" \
          --in-flight "$in_flight" --progress \
          2> >(tee "$noise" >&2) >/dev/null
    local secs chunks
    secs=$(awk '/elapsed/{print $NF}' "$noise")
    chunks=$(awk '/chunks/{print $NF}' "$noise")
    rm -f "$noise"

    printf '%-14s %10ss  %14s facts/s  %12s records/s  %s requests\n' \
      "big" "$secs" \
      "$(echo "$records $secs" | awk '{printf "%d", $1*4/$2}')" \
      "$(echo "$records $secs" | awk '{printf "%d", $1/$2}')" \
      "$chunks"

    # ClickHouse, same box, same records, one row per line instead of one fact per line -
    # because that is the shape each engine's own loader reads. Timed by `curl` rather than by
    # the shell: `date +%s` is whole seconds, and a load that takes 1.6 of them divided by 1 is
    # not a measurement.
    if [ -n "$have_ch" ]; then
      note "loading clickhouse" >&2
      cold_cache
      curl -sS "$ch/" --data-binary 'DROP TABLE IF EXISTS bench_t' >/dev/null
      curl -sS "$ch/" --data-binary 'CREATE TABLE bench_t (id UInt64, amount UInt64, category String, country String, active UInt8) ENGINE = MergeTree ORDER BY id' >/dev/null
      local chsecs
      chsecs=$(./target/release/facts "$records" "$shards" --rows \
        | curl -sS -o /dev/null -w '%{time_total}' \
            "$ch/?query=INSERT%20INTO%20bench_t%20FORMAT%20TSV" --data-binary @-)
      printf '%-14s %10ss  %14s facts/s  %12s records/s  %s\n' \
        "clickhouse" "$chsecs" \
        "$(echo "$records $chsecs" | awk '{printf "%d", $1*4/$2}')" \
        "$(echo "$records $chsecs" | awk '{printf "%d", $1/$2}')" \
        "1 request"
    else
      echo "clickhouse     not reachable at $ch (systemctl start clickhouse-server)"
    fi

    echo
    echo "file: $(du -h "$data/big.db" | cut -f1)"
    echo
    echo "Both numbers are wall clock over the wire, on the same box, with the page cache"
    echo "dropped between them - so unlike the in-process tables they can be read side by side."
    echo "What they are not is the same amount of work: big is given four facts per record"
    echo "because its import route takes facts, and its \`facts/s\` column exists to say so."
    echo "Compare the \`records/s\` column. Raise BENCH_CHUNK to send big fewer, larger"
    echo "requests; that is the same knob as fewer, larger commits, and clickhouse is getting"
    echo "one request for the lot."
  } | tee -a "$out"

  note "done: $out"
}

# Which symbols the daemon spends an import in.
#
# **`server` says how long, this says where.** They are deliberately the same load - same
# schema, same corpus, same chunking, through `server_up` - because a profile taken against a
# differently-configured daemon cannot be laid beside a throughput number and read together.
#
# perf is attached to the *running* `big serve` by pid rather than launching it, for two reasons.
# The startup and the schema DDL are not the thing being measured and would otherwise be
# several percent of a short run; and the profile then covers exactly the window `bigctl` is
# sending in, which is the window the throughput line below describes.
#
# Self time, not cumulative (`--no-children`). Call graphs need frame pointers or DWARF unwinding
# and both cost enough to bend the thing being measured; a flat table of where the cycles went
# is what has actually moved this engine, and it is honest at a sampling frequency this low.
cmd_profile() {
  local records="${1:-3000000}" shards="${2:-0}"

  if [ "$(uname -s)" != "Linux" ]; then
    red "profile needs Linux perf; this is $(uname -s)."
    red "  On macOS use a sampling profiler that speaks Mach: samply, or Instruments."
    red "    cargo install samply && samply record ./target/release/big serve ..."
    red "  Or run it where the numbers belong anyway:"
    red "    BENCH_HOST=<host> ./scripts/bench remote profile $records"
    exit 1
  fi
  if ! command -v perf >/dev/null; then
    red "no perf on this box:"
    red "  apt-get install -y linux-tools-common linux-tools-\$(uname -r)"
    red "and, so the time in libc is named rather than left as hex addresses:"
    red "  apt-get install -y libc6-dbg"
    exit 1
  fi

  check_room "$records" 0
  build --bin big --bin bigctl --bin facts
  server_up

  local freq="${BENCH_PROFILE_FREQ:-299}"
  local limit="${BENCH_PROFILE_LIMIT:-0.6}"
  local chunk="${BENCH_CHUNK:-7340032}"
  # `server`'s default, for the reason `server_up` is shared: a profile of a load nobody runs
  # names the wrong lines.
  local in_flight="${BENCH_IN_FLIGHT:-2}"
  local raw="$BIGD_DATA/perf.data"

  mkdir -p "$results"
  local stamp
  stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
  local out="$results/profile-$stamp.txt"
  { machine; echo "records       $records"; echo "engine        $BIGD_ENGINE"; \
    echo "durability    $BIGD_DURABILITY"; echo "chunk-bytes   $chunk"; \
    echo "in-flight     $in_flight"; echo "frequency     $freq Hz"; echo; } > "$out"

  note "recording big serve (pid $BIGD_PID) at ${freq}Hz"
  # No duration and no command: perf follows the pid until it is interrupted, which is what
  # makes the window exactly the load. `--` with a `sleep` was tried and is a ceiling nobody
  # can pick correctly - too short truncates a large run, too long makes every small one wait.
  perf record -F "$freq" -o "$raw" -p "$BIGD_PID" > "$BIGD_DATA/perf.log" 2>&1 &
  local perf_pid=$!
  BIGD_PERF_PID=$perf_pid
  # perf needs a moment to arm before the first byte arrives, or the opening of the load is
  # missing from a profile that claims to cover it.
  sleep 1
  if ! kill -0 "$perf_pid" 2>/dev/null; then
    red "perf could not attach:"
    sed 's/^/  /' "$BIGD_DATA/perf.log" >&2
    red "  most often this is the paranoia setting; as root:"
    red "    sysctl -w kernel.perf_event_paranoid=1"
    exit 1
  fi

  note "loading" >&2
  cold_cache
  local summary secs
  summary=$(./target/release/facts "$records" "$shards" \
    | ./target/release/bigctl import t - --addr "$BIGD_ADDR" --chunk-bytes "$chunk" \
        --in-flight "$in_flight" --progress)
  secs=$(echo "$summary" | awk '/^elapsed/{print $2}')

  # `SIGINT`, not `SIGKILL`: perf writes its buffers out on the way down, and a killed perf
  # leaves a perf.data that reports nothing. Waited on for the same reason - reading the file
  # before it has been finished is a race that shows up as a truncated report.
  #
  # Out here rather than inside the block below, which is piped into `tee` and therefore a
  # subshell: clearing `BIGD_PERF_PID` in there would not be seen by the `EXIT` trap, and the
  # cleanup would go on to signal a pid that has been reaped and possibly reissued.
  kill -INT "$perf_pid" 2>/dev/null || true
  wait "$perf_pid" 2>/dev/null || true
  BIGD_PERF_PID=""

  {
    echo "## import over HTTP, profiled  ($records records x 4 facts, engine $BIGD_ENGINE)"
    echo

    # Printed with the profile rather than only by `server`, because a symbol table without the
    # speed it was taken at cannot be compared with the next one.
    printf '%-14s %10ss  %14s facts/s  %12s records/s\n' \
      "big" "$secs" \
      "$(echo "$records $secs" | awk '{printf "%d", $1*4/$2}')" \
      "$(echo "$records $secs" | awk '{printf "%d", $1/$2}')"
    echo

    echo "## self time by symbol  (>= $limit%)"
    echo
    perf report -i "$raw" --stdio --no-children --percent-limit "$limit" 2>/dev/null \
      | grep -v '^#' | grep -v '^$' | sed 's/  *$//'
    echo
    echo "Self time, so a caller is not credited with its callee's cycles: these percentages"
    echo "name the lines to change rather than the paths they sit on. They are shares of one"
    echo "run at the speed printed above, so two profiles are comparable only when that line"
    echo "is too - a symbol falling from 8% to 1% while the run got slower is not a win."
    echo
    echo "The speed above is a *profiled* one. Measured on a two-vCPU box at 299 Hz, perf"
    echo "costs about half of it - two million records took 19.5s here and 9.9s with nothing"
    echo "attached - because perf's own writer wants one of the two cores. Read this number"
    echo "against another profile, never against \`bench server\`; that is what \`server\` is"
    echo "for. BENCH_PROFILE_FREQ=99 buys most of that back, at a thinner sample."
  } | tee -a "$out"

  # Kept, because the report is one view of it. Re-read with other options - `--sort dso`,
  # `--percent-limit 0`, `perf annotate` - without paying for the load again.
  cp "$raw" "$results/profile-$stamp.perf" 2>/dev/null || true
  note "raw samples: $results/profile-$stamp.perf"
  note "  perf report -i $results/profile-$stamp.perf --stdio --no-children --percent-limit 0"
  note "done: $out"
}

case "${1:-}" in
  load)    shift; cmd_load "$@" ;;
  profile) shift; cmd_profile "$@" ;;
  ab)      shift; cmd_ab "$@" ;;
  server)  shift; cmd_server "$@" ;;
  olap)    shift; cmd_olap "$@" ;;
  storage) shift; cmd_storage ;;
  compare) shift; cmd_compare ;;
  all)     shift; cmd_load "${1:-1000000}"; cmd_storage; cmd_olap "${1:-200000}" ;;
  remote)  shift; cmd_remote "$@" ;;
  env)     machine ;;
  ""|-h|--help|help) usage ;;
  *)       red "unknown command: $1"; echo; usage; exit 2 ;;
esac
