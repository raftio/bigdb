.ruff_cache/
.mypy_cache/
.coverage
clients/python/dist/
clients/python/.venv/
clients/python/*.egg-info/

# Go clients. Build output and coverage only - this module vendors nothing, so there is no
# vendor/ entry, and its absence is part of the zero-dependency claim.
clients/go/*.test
clients/go/coverage.out
clients/go/dist/
